# NOTE: git treats quotes in .gitignore as LITERAL characters. The previous
# version of this file wrote every pattern as "venv/" (with quotes), so none of
# them ever matched -- the venv, secrets and logs were only untracked by luck.
# Patterns below are unquoted and therefore actually effective.

# --- virtualenvs / bytecode ---
venv/
.venv/
__pycache__/
*.py[cod]

# --- secrets: never commit ---
.env
.env.*
!.env.example

# --- runtime state (host-specific, never portable) ---
logs/
*.log
runtime/
db/*.db
db/*.db-wal
db/*.db-shm
db/*.db-journal
*.session
*.session-journal

# --- timestamped safety backups (local only, never commit) ---
*.bak_*
*_cursor_copy.py
*.retired_*

# --- generated exports / reports (business data, never commit) ---
exports/
*.xlsx

# --- one-off diagnostic / repair scripts (write under tools/, run, delete) ---
/check_*.py
/repair_*.py

# --- archives / editor noise ---
*.rar
*.zip
.idea/
.vscode/
.DS_Store
