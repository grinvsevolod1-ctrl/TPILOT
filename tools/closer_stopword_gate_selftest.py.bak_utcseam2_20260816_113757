class FakeLog:
    def warning(self, *a, **kw): pass
    def info(self, *a, **kw): pass
    def exception(self, *a, **kw): pass


class FakeButton:
    @staticmethod
    def inline(text, data):
        return ("btn", text, data if isinstance(data, (bytes, bytearray)) else str(data).encode("utf-8"))


