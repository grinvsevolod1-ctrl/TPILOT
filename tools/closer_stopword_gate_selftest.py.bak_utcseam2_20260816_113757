def test_8_allow_spend_count_unchanged() -> None:
    """AST-based (not textual) count: allow_spend=True as a REAL call keyword
    argument, ignoring comments/docstrings that merely mention it."""
    src = open(MAIN_PATH, encoding="utf-8-sig").read()
    tree = ast.parse(src)
    hits = 0
    for node in ast.walk(tree):
        if isinstance(node, ast.Call):
            for kw in node.keywords:
                if kw.arg == "allow_spend" and isinstance(kw.value, ast.Constant) and kw.value.value is True:
                    hits += 1
    check("8. allow_spend=True still appears as a real call argument in exactly 2 places (main.py)", hits == 2, hits)


def test_8_no_replacement_notification_or_adminbot_wizard_touch() -> None:
    src = open(MAIN_PATH, encoding="utf-8-sig").read()
    gate_start = src.index("TPILOT CLOSER AUTOMATION ISOLATION + STOPWORD GATE 20260716 START")
