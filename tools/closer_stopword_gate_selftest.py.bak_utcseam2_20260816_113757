def test_8_gate_wired_into_every_send_path() -> None:
    src = open(MAIN_PATH, encoding="utf-8-sig").read()
    gate_call_count = src.count("await _lead_automation_gate(")
    check("8. _lead_automation_gate is called from at least 6 real send sites", gate_call_count >= 6, gate_call_count)

    checks = [
        ('night_greeting" kind used in _maybe_auto_reply_to_lead', src.count('"night_greeting", state)') >= 2),
        ('day_greeting" kind used in _maybe_auto_reply_to_lead', '"day_greeting", state)' in src),
        ('questionnaire" kind used in _tp_gq_send_questionnaire_followup', '"questionnaire", state)' in src),
        ('profile_reminder" kind used in profile reminder loop', '"profile_reminder")' in src),
        ('autodozhim" kind used in autodozhim loop', '"autodozhim")' in src),
        ('stop-word write site also calls _set_lead_automation_stopped', "await _set_lead_automation_stopped(DB_PATH, chat_id, reason=\"manual_stop_word\")" in src),
    ]
    for label, ok in checks:
        check(f"8. {label}", ok)


