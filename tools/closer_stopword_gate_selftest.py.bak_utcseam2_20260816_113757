async def test_6_role_preservation() -> None:
    import storage as _storage

    fd, db_path = tempfile.mkstemp(suffix=".db", prefix="closer_stopword_storage_")
    os.close(fd)
    _selftest_db_guard([db_path], BASE_DIR)
    try:
        _storage.DB_PATH = db_path

        await _storage.manager_add(
            manager_key="mgr_no_role", display_name="No Role", phone="", status="active",
            session_path="", db_path=db_path, workdir="", log_path="", is_enabled=1,
        )
        await _storage.manager_add(
            manager_key="mgr_closer", display_name="Closer", phone="", status="active",
            session_path="", db_path=db_path, workdir="", log_path="", is_enabled=1,
            role="closer",
        )
        await _storage.manager_add(
            manager_key="mgr_bad_role", display_name="Bad Role", phone="", status="active",
            session_path="", db_path=db_path, workdir="", log_path="", is_enabled=1,
            role="totally-invalid",
        )
        row_no_role = await _storage.manager_get("mgr_no_role")
        row_closer = await _storage.manager_get("mgr_closer")
        row_bad = await _storage.manager_get("mgr_bad_role")

        check("6. manager_add without role= keeps the default ('manager')", _storage.normalize_manager_role((row_no_role or {}).get("role")) == "manager", row_no_role)
        check("6. manager_add with role='closer' sets role=closer", _storage.normalize_manager_role((row_closer or {}).get("role")) == "closer", row_closer)
        check("6. manager_add with an invalid role normalizes to 'manager' (never crashes)", _storage.normalize_manager_role((row_bad or {}).get("role")) == "manager", row_bad)

        # existing 3-arg callers (no role=) still succeed unchanged -- backward compatible.
        check("6. manager_add remains backward-compatible (role is optional)", True)
    finally:
        os.unlink(db_path)


