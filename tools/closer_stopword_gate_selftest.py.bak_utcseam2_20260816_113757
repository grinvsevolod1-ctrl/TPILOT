async def test_7_closer_toggle_ui() -> None:
    ns, db_path = _fresh_mb_toggle_ns()
    try:
        check("7. day toggle default is OFF (missing key)", _toggle_get(ns, MB_CLOSER_MK, "day") is False)
        check("7. night toggle default is OFF (missing key)", _toggle_get(ns, MB_CLOSER_MK, "night") is False)

        menu_buttons = ns["_cls_menu_buttons"](MB_CLOSER_MK)
        flat_data = [btn[2] for row in menu_buttons for btn in row]
        check("7. menu has a day-greeting toggle button", any(d == f"cls:tg:day:{MB_CLOSER_MK}".encode("utf-8") for d in flat_data), flat_data)
        check("7. menu has a night-greeting toggle button", any(d == f"cls:tg:night:{MB_CLOSER_MK}".encode("utf-8") for d in flat_data), flat_data)
        for row in menu_buttons:
            for btn in row:
                check(f"7. callback_data stays under 64 bytes ({btn[2]!r})", len(btn[2]) <= 64, btn[2])

        # tapping the day toggle flips it ON and re-renders the menu in place.
        cb = FakeCallbackEvent(f"cls:tg:day:{MB_CLOSER_MK}".encode("utf-8"), MB_CLOSER_UID)
        await ns["_cls_callback"](cb)
        check("7. day toggle flips to ON after one tap", _toggle_get(ns, MB_CLOSER_MK, "day") is True)
        check("7. toggle tap edits the menu in place", len(cb.edits) == 1, cb.edits)
        check("7. night toggle is untouched by the day tap", _toggle_get(ns, MB_CLOSER_MK, "night") is False)

        # tapping again flips it back OFF.
        cb2 = FakeCallbackEvent(f"cls:tg:day:{MB_CLOSER_MK}".encode("utf-8"), MB_CLOSER_UID)
        await ns["_cls_callback"](cb2)
        check("7. day toggle flips back to OFF after a second tap", _toggle_get(ns, MB_CLOSER_MK, "day") is False)

        # view screen reflects toggle state.
        _toggle_set(ns, MB_CLOSER_MK, "night", True)
        view = ns["_cls_view_text"](MB_CLOSER_MK)
        check("7. view screen shows night ON", "Ночное приветствие: 🟢 ВКЛ" in view, view)
        check("7. view screen shows day OFF", "Дневное приветствие: 🔴 ВЫКЛ" in view, view)

        # saving greeting/away TEXT never flips a toggle (independent state).
        before_day = _toggle_get(ns, MB_CLOSER_MK, "day")
        ns["_cls_set_setting"](ns["_cls_greeting_key"](MB_CLOSER_MK), "New greeting text")
        after_day = _toggle_get(ns, MB_CLOSER_MK, "day")
        check("7. saving greeting text never auto-enables the day toggle", before_day == after_day == False, (before_day, after_day))

        # forged cross-closer toggle callback is denied (ownership re-check).
        forged = FakeCallbackEvent(f"cls:tg:day:{MB_OTHER_CLOSER_MK}".encode("utf-8"), MB_CLOSER_UID)
        await ns["_cls_callback"](forged)
        check("7. forged toggle callback for another closer's key is denied", forged.answers and forged.answers[-1][1] is True, forged.answers)
        check("7. forged toggle callback never edits any message", forged.edits == [], forged.edits)
        check("7. the target closer's own toggle is untouched by the forged attempt", _toggle_get(ns, MB_OTHER_CLOSER_MK, "day") is False)
    finally:
        os.unlink(db_path)


