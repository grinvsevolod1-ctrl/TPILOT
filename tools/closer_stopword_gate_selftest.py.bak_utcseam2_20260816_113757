def _make_central_db() -> str:
    fd, path = tempfile.mkstemp(suffix=".db", prefix="closer_stopword_central_")
    os.close(fd)
    con = sqlite3.connect(path)
    try:
        con.execute("CREATE TABLE managers(manager_key TEXT PRIMARY KEY, role TEXT)")
        con.execute("CREATE TABLE settings(key TEXT PRIMARY KEY, value TEXT NOT NULL DEFAULT '')")
        con.commit()
    finally:
        con.close()
    return path


def _seed_central(db_path: str, *, roles: dict, kv: dict) -> None:
    con = sqlite3.connect(db_path)
    try:
        for k, role in roles.items():
            con.execute(
                "INSERT INTO managers(manager_key, role) VALUES (?,?) "
                "ON CONFLICT(manager_key) DO UPDATE SET role=excluded.role",
                (k, role),
            )
        for k, v in kv.items():
            con.execute(
                "INSERT INTO settings(key, value) VALUES (?,?) "
                "ON CONFLICT(key) DO UPDATE SET value=excluded.value",
                (k, v),
            )
        con.commit()
    finally:
        con.close()


def _make_manager_db() -> str:
