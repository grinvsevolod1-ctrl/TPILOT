def _extract_and_exec(path: str, names: set, extra_ns: dict) -> dict:
    src = open(path, encoding="utf-8-sig").read()
    tree = ast.parse(src)
    nodes = []
    seen = set()
    for n in tree.body:
        nm = getattr(n, "name", None)
        if nm and nm in names:
            nodes.append(n)
            seen.add(nm)
            continue
        if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name) and n.targets[0].id in names:
            nodes.append(n)
            seen.add(n.targets[0].id)
            continue
        if isinstance(n, ast.AnnAssign) and isinstance(n.target, ast.Name) and n.target.id in names:
            nodes.append(n)
            seen.add(n.target.id)
            continue
    missing = names - seen
    if missing:
        raise AssertionError(f"expected {names}, missing {missing} in {path}")
    module_src = "\n\n".join(ast.unparse(n) for n in nodes)
    ns = dict(extra_ns)
    exec(compile(module_src, f"<{path}>", "exec"), ns)
    return ns


def _selftest_db_guard(paths: list, base_dir: Path) -> None:
    """Refuses to run against any path under <repo>/db (boundary-checked
    with os.sep so a sibling like .../dbfoo is never a false match)."""
    prod_db_dir = os.path.abspath(os.path.join(str(base_dir), "db"))
    for p in paths:
        target = os.path.abspath(str(p))
        unsafe = target == prod_db_dir or target.startswith(prod_db_dir + os.sep)
        assert not unsafe, f"refusing to run selftest storage against a path under {prod_db_dir}: {p}"


def test_dbguard_rejects_unsafe_paths() -> None:
    try:
        _selftest_db_guard([str(BASE_DIR / "db" / "data_tpilot.db")], BASE_DIR)
        check("(security) db guard rejects a path under <repo>/db", False, "did not raise")
    except AssertionError:
        check("(security) db guard rejects a path under <repo>/db", True)
    # sibling directory name must NOT false-positive
    try:
        _selftest_db_guard([str(BASE_DIR / "dbfoo" / "x.db")], BASE_DIR)
        check("(security) db guard does not false-positive on a sibling 'dbfoo' dir", True)
    except AssertionError as e:
        check("(security) db guard does not false-positive on a sibling 'dbfoo' dir", False, repr(e))


