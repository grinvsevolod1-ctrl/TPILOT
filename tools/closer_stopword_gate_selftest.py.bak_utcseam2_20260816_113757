def test_1_stopword_matching() -> None:
    ns = build_gate_ns(":memory:", ":memory:")
    fn = ns["_is_post_followup_disable_word"]
    check("1. exact lowercase stop-word matches", fn("ссууппеерр") is True)
    check("1. mixed-case stop-word matches (casefold)", fn("СсУуППеЕрр") is True)
    check("1. whitespace-padded stop-word matches (stripped)", fn("  ссууппеерр  ") is True)
    check("1. wrong spelling does NOT match", fn("ссуппеерр") is False)
    check("1. single-letter-count difference does NOT match", fn("ссууппееррр") is False)
    check("1. substring within a longer message does NOT match", fn("привет ссууппеерр как дела") is False)
    check("1. empty/None text does NOT match", fn("") is False and fn(None) is False)


async def test_2_durable_stop_state() -> None:
    db_path = _make_manager_db()
    _selftest_db_guard([db_path], BASE_DIR)
    try:
        ns = build_gate_ns(db_path, ":memory:")
        set_stopped = ns["_set_lead_automation_stopped"]
        get_state = ns["_get_auto_state"]

        await set_stopped(db_path, 111, reason="manual_stop_word")
        st = await get_state(db_path, 111)
        check("2. stop flag persisted after first trigger", int(st.get("automation_stopped") or 0) == 1, st)
        first_at = st.get("automation_stopped_at")
        check("2. reason recorded", st.get("automation_stopped_reason") == "manual_stop_word", st)
        check("2. timestamp recorded (non-empty)", bool(first_at), st)

        # duplicate trigger must be a no-op (idempotent): timestamp/reason unchanged.
        await set_stopped(db_path, 111, reason="manual_stop_word")
        await set_stopped(db_path, 111, reason="different_reason_should_be_ignored")
        st2 = await get_state(db_path, 111)
        check("2. duplicate stop-word trigger is idempotent (timestamp unchanged)", st2.get("automation_stopped_at") == first_at, (first_at, st2.get("automation_stopped_at")))
        check("2. duplicate trigger never overwrites the original reason", st2.get("automation_stopped_reason") == "manual_stop_word", st2)

        # "restart": reopen the same sqlite file via a fresh extraction namespace.
        ns2 = build_gate_ns(db_path, ":memory:")
        st3 = await ns2["_get_auto_state"](db_path, 111)
        check("2. stop flag survives a simulated restart (fresh process, same db file)", int(st3.get("automation_stopped") or 0) == 1, st3)

        # a different lead in the SAME manager db is unaffected.
        st_other = await get_state(db_path, 222)
        check("2. a different chat_id in the same db is NOT stopped", int(st_other.get("automation_stopped") or 0) == 0, st_other)

        # no code path in this module clears the flag -- static confirmation.
        src = open(MAIN_PATH, encoding="utf-8-sig").read()
        check("2. no code path sets automation_stopped back to 0 anywhere in main.py", "automation_stopped=0" not in src and "automation_stopped = 0" not in src)
    finally:
        os.unlink(db_path)


async def test_3_ordinary_manager_before_after_stop() -> None:
    db_path = _make_manager_db()
    central_path = _make_central_db()
    _selftest_db_guard([db_path, central_path], BASE_DIR)
    try:
        _seed_central(central_path, roles={"alpha01": "manager"}, kv={})
        ns = build_gate_ns(db_path, central_path)
        gate = ns["_lead_automation_gate"]

        for kind in ("day_greeting", "night_greeting", "questionnaire", "profile_reminder", "autodozhim"):
            allowed, reason = await gate("alpha01", 501, kind)
            check(f"3. ordinary manager BEFORE stop word: '{kind}' allowed", allowed and reason == "ordinary_manager", (allowed, reason))

        await ns["_set_lead_automation_stopped"](db_path, 501, reason="manual_stop_word")
        for kind in ("day_greeting", "night_greeting", "questionnaire", "profile_reminder", "autodozhim", "llm"):
            allowed, reason = await gate("alpha01", 501, kind)
            check(f"3. ordinary manager AFTER stop word: '{kind}' denied", not allowed and reason == "manual_stop_word", (allowed, reason))

        # a different lead for the SAME ordinary manager is unaffected.
        allowed, reason = await gate("alpha01", 999, "day_greeting")
        check("3. a different lead for the same manager is unaffected by another lead's stop", allowed and reason == "ordinary_manager", (allowed, reason))
    finally:
        os.unlink(db_path)
        os.unlink(central_path)


async def test_4_closer_isolation() -> None:
    db_path = _make_manager_db()
    central_path = _make_central_db()
    _selftest_db_guard([db_path, central_path], BASE_DIR)
    try:
        _seed_central(
            central_path,
            roles={"vinch": "closer"},
            kv={
                "closer_greeting_text_vinch": "Custom day text",
                "closer_away_text_vinch": "Custom night text",
            },
        )
        ns = build_gate_ns(db_path, central_path)
        gate = ns["_lead_automation_gate"]

        # both toggles OFF (default/missing key) -> sends nothing, including greetings.
        for kind in ("day_greeting", "night_greeting", "questionnaire", "profile_reminder", "autodozhim", "llm"):
            allowed, reason = await gate("vinch", 601, kind)
            check(f"4. closer both-toggles-OFF: '{kind}' denied", not allowed, (kind, allowed, reason))

        # non-greeting kinds are ALWAYS denied for a closer, toggles irrelevant.
        _seed_central(central_path, roles={}, kv={"closer_day_greeting_enabled_vinch": "1", "closer_night_greeting_enabled_vinch": "1"})
        for kind in ("questionnaire", "profile_reminder", "autodozhim", "llm"):
            allowed, reason = await gate("vinch", 601, kind)
            check(f"4. closer both-toggles-ON: '{kind}' still denied unconditionally", not allowed and reason == "closer_denied", (kind, allowed, reason))

        # day-only ON -> day allowed, night still denied.
        _seed_central(central_path, roles={}, kv={"closer_day_greeting_enabled_vinch": "1", "closer_night_greeting_enabled_vinch": "0"})
        allowed_day, _ = await gate("vinch", 601, "day_greeting")
        allowed_night, _ = await gate("vinch", 601, "night_greeting")
        check("4. closer day-only: day_greeting allowed", allowed_day is True)
        check("4. closer day-only: night_greeting still denied", allowed_night is False)

        # night-only ON -> night allowed, day still denied.
        _seed_central(central_path, roles={}, kv={"closer_day_greeting_enabled_vinch": "0", "closer_night_greeting_enabled_vinch": "1"})
        allowed_day2, _ = await gate("vinch", 601, "day_greeting")
        allowed_night2, _ = await gate("vinch", 601, "night_greeting")
        check("4. closer night-only: day_greeting still denied", allowed_day2 is False)
        check("4. closer night-only: night_greeting allowed", allowed_night2 is True)

        # both ON -> both allowed.
        _seed_central(central_path, roles={}, kv={"closer_day_greeting_enabled_vinch": "1", "closer_night_greeting_enabled_vinch": "1"})
        allowed_day3, _ = await gate("vinch", 601, "day_greeting")
        allowed_night3, _ = await gate("vinch", 601, "night_greeting")
        check("4. closer both-ON: day_greeting allowed", allowed_day3 is True)
        check("4. closer both-ON: night_greeting allowed", allowed_night3 is True)

        # enabled toggle but EMPTY custom text -> fails closed.
        _seed_central(
            central_path,
            roles={"vinch2": "closer"},
            kv={"closer_day_greeting_enabled_vinch2": "1", "closer_greeting_text_vinch2": "   "},
        )
        allowed_empty, reason_empty = await gate("vinch2", 602, "day_greeting")
        check("4. closer toggle ON but custom text empty/whitespace -> fails closed", not allowed_empty and reason_empty == "closer_text_empty", (allowed_empty, reason_empty))

        # a stale ordinary-manager autodozhim flag is irrelevant -- closer autodozhim
        # is denied regardless (already covered above), and follow-up/catchup/LLM
        # kinds ignore the closer's greeting toggles entirely (kind isn't in the
        # day/night set -> unconditional closer_denied, proven above).

        # restart: fresh namespace, same central db -- toggle state persists.
        ns2 = build_gate_ns(db_path, central_path)
        allowed_restart, _ = await ns2["_lead_automation_gate"]("vinch", 601, "day_greeting")
        check("4. closer toggle state survives a simulated restart", allowed_restart is True)
    finally:
        os.unlink(db_path)
        os.unlink(central_path)


async def test_5_combined_rules() -> None:
    db_path = _make_manager_db()
    central_path = _make_central_db()
    _selftest_db_guard([db_path, central_path], BASE_DIR)
    try:
        _seed_central(
            central_path,
            roles={"vinch": "closer"},
            kv={
                "closer_greeting_text_vinch": "Custom day text",
                "closer_away_text_vinch": "Custom night text",
                "closer_day_greeting_enabled_vinch": "1",
                "closer_night_greeting_enabled_vinch": "1",
            },
        )
        ns = build_gate_ns(db_path, central_path)
        gate = ns["_lead_automation_gate"]

        allowed_before, _ = await gate("vinch", 701, "day_greeting")
        check("5. closer with BOTH toggles enabled sends day_greeting before stop word", allowed_before is True)

        await ns["_set_lead_automation_stopped"](db_path, 701, reason="manual_stop_word")
        allowed_after, reason_after = await gate("vinch", 701, "day_greeting")
        check("5. stop word overrides an ENABLED closer toggle for that lead", not allowed_after and reason_after == "manual_stop_word", (allowed_after, reason_after))
        allowed_after_night, reason_after_night = await gate("vinch", 701, "night_greeting")
        check("5. stop word also blocks the closer's night_greeting for that lead", not allowed_after_night and reason_after_night == "manual_stop_word", (allowed_after_night, reason_after_night))

        # a DIFFERENT lead for the SAME closer, with the SAME enabled toggles,
        # is completely unaffected by lead 701's stop.
        allowed_other_lead, reason_other_lead = await gate("vinch", 702, "day_greeting")
        check("5. a different lead for the same closer is unaffected by another lead's stop", allowed_other_lead and reason_other_lead == "closer_allowed", (allowed_other_lead, reason_other_lead))
    finally:
        os.unlink(db_path)
        os.unlink(central_path)


