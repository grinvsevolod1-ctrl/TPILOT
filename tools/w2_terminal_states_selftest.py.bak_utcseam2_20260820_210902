# ======================================================================
# Idempotency (point 9-10): replaying the same event does not change an
# already-terminal outcome, and does not overwrite an already-'sent' row.
# ======================================================================

def test_terminal_state_idempotent_and_never_overwrites_sent() -> None:
    db = _make_temp_db()
    try:
        ns = build_ns(db)
        _insert_event(db, 7, mk="")  # invalid -> terminal_invalid_event
        asyncio.run(ns["_send_event_to_user"](_make_row(7, mk=""), 700))
        first = _row(db, 700, 7)
        # Replay the classifier / terminal write directly.
        wrote_again = ns["_mb_write_terminal_state"](7, 700, "terminal_invalid_event", "missing_required_fields")
        second = _row(db, 700, 7)
        check("replaying a terminal write on an ALREADY-terminal row reports no new write (idempotent)",
              wrote_again is False, wrote_again)
        check("the row is byte-for-byte unchanged after the replay", first == second, (first, second))

        # A 'sent' row must never be overwritten by a terminal write either.
        con = sqlite3.connect(db)
        con.execute("INSERT INTO manager_bot_sent(tg_user_id, event_id, sent_at, send_status) "
                    "VALUES (701, 8, '2026-07-29T00:00:00', 'sent')")
        con.commit()
        con.close()
        wrote_over_sent = ns["_mb_write_terminal_state"](8, 701, "terminal_access_denied", "access_denied_at_send_time")
        after = _row(db, 701, 8)
        check("a terminal write NEVER overwrites an already-'sent' row", wrote_over_sent is False, wrote_over_sent)
        check("the 'sent' row is completely unchanged", after["send_status"] == "sent", after)
    finally:
        os.unlink(db)


