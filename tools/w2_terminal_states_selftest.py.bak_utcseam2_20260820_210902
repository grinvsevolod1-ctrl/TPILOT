        os.unlink(db)


# ======================================================================
# TERMINAL_MANAGER_DELETED: manager_key has no active `managers` row.
# ======================================================================

def test_terminal_manager_deleted() -> None:
    db = _make_temp_db()
    try:
        ns = build_ns(db)
        _insert_event(db, 4, mk="mgr_gone")
        # No `managers` row for mgr_gone at all.
        asyncio.run(ns["_send_event_to_user"](_make_row(4, mk="mgr_gone"), 400))
        row = _row(db, 400, 4)
        check("deleted manager: send_status='terminal_manager_deleted'",
              row is not None and row["send_status"] == "terminal_manager_deleted", row)

        # Also prove the inactive-but-present case (status != 'active').
        con = sqlite3.connect(db)
        con.execute("INSERT INTO managers(manager_key, status, is_enabled) VALUES ('mgr_inactive','paused',1)")
        con.commit()
        con.close()
        _insert_event(db, 5, mk="mgr_inactive")
        asyncio.run(ns["_send_event_to_user"](_make_row(5, mk="mgr_inactive"), 400))
        row2 = _row(db, 400, 5)
        check("inactive (non-'active' status) manager also yields terminal_manager_deleted",
              row2 is not None and row2["send_status"] == "terminal_manager_deleted", row2)
    finally:
        os.unlink(db)


