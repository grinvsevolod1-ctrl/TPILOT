def test_terminal_invalid_event() -> None:
    db = _make_temp_db()
    try:
        ns = build_ns(db)
        bad_row = _make_row(3, mk="")  # no manager_key
        asyncio.run(ns["_send_event_to_user"](bad_row, 300))
        row = _row(db, 300, 3)
        check("invalid event: a REAL persisted row exists (not silently dropped)", row is not None, row)
        check("invalid event: send_status='terminal_invalid_event'",
