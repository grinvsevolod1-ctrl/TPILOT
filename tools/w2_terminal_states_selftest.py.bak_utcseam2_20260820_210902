# ======================================================================
# CUTOFF_SUPPRESSED persistence (storage.w2_persist_cutoff_suppressed_events).
# ======================================================================

def test_cutoff_suppressed_persistence() -> None:
    db = _make_temp_db()
    try:
        for i in range(1, 4):
            _insert_event(db, i, mk="mgrc")
        con = sqlite3.connect(db)
        con.execute("INSERT INTO manager_bot_access(tg_user_id, manager_key, can_receive_cards, revoked, event_cutoff_id) "
                    "VALUES (1000, 'mgrc', 1, 0, 2)")
        before_cutoff = con.execute("SELECT event_cutoff_id FROM manager_bot_access WHERE tg_user_id=1000").fetchone()[0]
        con.commit()
        con.close()

        result = storage.w2_persist_cutoff_suppressed_events(db_path=db)
        check("cutoff persistence reports rows_inserted=2 (events 1,2 <= cutoff 2)",
              result.get("rows_inserted") == 2, result)

        con = sqlite3.connect(db)
        con.row_factory = sqlite3.Row
        row1 = con.execute("SELECT send_status FROM manager_bot_sent WHERE tg_user_id=1000 AND event_id=1").fetchone()
        row2 = con.execute("SELECT send_status FROM manager_bot_sent WHERE tg_user_id=1000 AND event_id=2").fetchone()
        row3 = con.execute("SELECT send_status FROM manager_bot_sent WHERE tg_user_id=1000 AND event_id=3").fetchone()
        after_cutoff = con.execute("SELECT event_cutoff_id FROM manager_bot_access WHERE tg_user_id=1000").fetchone()[0]
        con.close()
        check("event 1 (id<=cutoff) persisted as cutoff_suppressed", row1["send_status"] == "cutoff_suppressed", row1)
        check("event 2 (id<=cutoff) persisted as cutoff_suppressed", row2["send_status"] == "cutoff_suppressed", row2)
        check("event 3 (id>cutoff) has NO manager_bot_sent row at all (still ordinary PENDING)", row3 is None, row3)
        check("event_cutoff_id is BYTE-FOR-BYTE unchanged by this persistence pass",
              before_cutoff == after_cutoff == 2, (before_cutoff, after_cutoff))

        snap = storage.w2_terminal_events_snapshot(db_path=db)
        check("w2_terminal_events_snapshot reports cutoff_suppressed=2", snap.get("cutoff_suppressed") == 2, snap)

        # Idempotent: running again inserts nothing new.
        result2 = storage.w2_persist_cutoff_suppressed_events(db_path=db)
        check("re-running cutoff persistence is idempotent (0 new rows)", result2.get("rows_inserted") == 0, result2)
    finally:
        os.unlink(db)


def test_no_delete_anywhere_in_terminal_state_paths() -> None:
    import re
    delete_rx = re.compile(r"\bDELETE\s+FROM\b", re.IGNORECASE)
    src_1 = ast.unparse(_last_def("_mb_write_terminal_state"))
    src_2 = ast.unparse(_last_def("_find_manager_row_by_key"))
    check("_mb_write_terminal_state contains no 'DELETE FROM' statement", not delete_rx.search(src_1), None)
    check("_find_manager_row_by_key contains no 'DELETE FROM' statement", not delete_rx.search(src_2), None)
    storage_src = open(str(BASE_DIR / "storage.py"), encoding="utf-8-sig").read()
    idx = storage_src.index("def w2_persist_cutoff_suppressed_events")
    end = storage_src.index("\ndef ", idx + 10)
    check("w2_persist_cutoff_suppressed_events contains no 'DELETE FROM' statement",
          not delete_rx.search(storage_src[idx:end]), None)


def main() -> int:
    test_happy_path_still_sends()
    test_d02_backlog_class_actually_delivered_end_to_end()
    test_terminal_invalid_event()
    test_terminal_manager_deleted()
    test_terminal_access_denied()
    test_terminal_state_idempotent_and_never_overwrites_sent()
    test_terminal_states_excluded_from_selection()
    test_cutoff_suppressed_persistence()
    test_no_delete_anywhere_in_terminal_state_paths()

    print()
    if FAILURES:
        print(f"SELFTEST FAILED: {len(FAILURES)} check(s) failed:")
        for f in FAILURES:
            print(f"  - {f}")
        return 1
    print("SELFTEST OK: all checks passed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
