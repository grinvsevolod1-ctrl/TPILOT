def test_migration():
    print("\n-- Migration (plan 23-D.1): additive, idempotent --")
    db_path = _make_temp_db(legacy_partner_sent_events=True)
    try:
        # A pre-existing legacy row (successful delivery before this patch).
        con = sqlite3.connect(db_path)
        con.execute("INSERT INTO partner_sent_events(user_id, event_id, sent_at) VALUES (1, 42, '2026-08-01T00:00:00')")
        con.commit()
        con.close()

        ns = build_ns(db_path)
        ns["_ensure_tables"]()
        cols = {r[1] for r in sqlite3.connect(db_path).execute("PRAGMA table_info(partner_sent_events)").fetchall()}
        check("M1. send_status column added", "send_status" in cols, cols)
        check("M2. attempts column added", "attempts" in cols, cols)
        check("M3. next_attempt_at column added", "next_attempt_at" in cols, cols)
        check("M4. last_error_class column added", "last_error_class" in cols, cols)

        row = _sent_row(db_path, 1, 42)
        check("M5. pre-existing legacy row defaults to send_status='sent' (no backfill needed)",
              row is not None and row["send_status"] == "sent", dict(row) if row else None)
        check("M6. pre-existing legacy row defaults to attempts=0", row["attempts"] == 0, row["attempts"])

        # Idempotent re-run (AG: second pass causes zero additional change).
        ns["_ensure_tables"]()
        ns["_ensure_tables"]()
        row2 = _sent_row(db_path, 1, 42)
        check("M7. repeated _ensure_tables() is idempotent, row unchanged",
              dict(row2) == dict(row), (dict(row2), dict(row)))
    finally:
        _safe_unlink_db(db_path)


# ======================================================================
# LARGE-T1/T2/T3 + AR: poison formatting event -> plain fallback -> if that
# ALSO fails, dead-letters immediately (D.2) and does not block later events.
# ======================================================================

def test_poison_event_dead_letters():
    print("\n-- LARGE-T1/T2/AR: poison formatting event dead-letters, does not block queue --")
    db_path = _make_temp_db(legacy_partner_sent_events=False)
    try:
        poison_id = _insert_event(db_path, event_key="poison", username="a_b_c*d`e")
        healthy_id = _insert_event(db_path, event_key="healthy", username="plainuser")

        client = _FakeClient()
        client.fail_always(lambda: _EntityBoundsInvalidError("Some of provided entities have invalid bounds"))
        ns = build_ns(db_path, client=client, max_attempts=3)

        # LARGE-T2 proof: BOTH the html attempt and the plain fallback are attempted
        # (both fail here), which is what _pse_send_notification is responsible for.
        try:
            run(ns["_pse_send_notification"](999, {"id": poison_id, "manager_key": "mgr1",
                                                    "manager_display_name": "M", "manager_username": "",
                                                    "chat_id": 1, "username": "a_b_c*d`e", "full_name": "",
                                                    "phone": "", "first_seen_utc": "2026-08-12T10:00:00"}, BUYER))
            raised = False
        except Exception:
            raised = True
        check("T2a. formatted attempt AND plain fallback both attempted (2 send_message calls)",
              len(client.calls) == 2, len(client.calls))
        check("T2b. first attempt used parse_mode='html'", client.calls[0]["parse_mode"] == "html", client.calls[0])
        check("T2c. fallback attempt used parse_mode=None", client.calls[1]["parse_mode"] is None, client.calls[1])
        check("T2d. exhausted formatting failure propagates to the caller", raised, raised)

        # LARGE-T1/AR proof: run it through _pse_record_failure the way
        # _notify_live_leads_once's except-branch does -- a deterministic
        # formatting failure that survived the plain-text fallback must
        # dead-letter IMMEDIATELY (plan 23-D.2), not consume the bounded
        # retry budget.
        ns["_pse_record_failure"](999, poison_id, _EntityBoundsInvalidError("Some of provided entities have invalid bounds"))
        row = _sent_row(db_path, 999, poison_id)
        check("T1a/AR-1. poison event reaches send_status='dead' on the FIRST recorded failure",
              row is not None and row["send_status"] == "dead", dict(row) if row else None)
        check("T1b. attempts recorded as 1 (not incremented further after dead)", row["attempts"] == 1, row["attempts"])

        # T3: the poison event must never be reselected...
        pending = ns["_pending_events_for_source"]("src1", limit=10, user_id=999)
        pending_ids = [int(r["id"]) for r in pending]
        check("T3a. dead poison event is never reselected", poison_id not in pending_ids, pending_ids)
        # ...and a LATER, healthy event in the same batch is still selectable
        # (one poison event must never block the events that follow it).
        check("T3b. healthy event in the same source is still selectable (poison did not block the queue)",
              healthy_id in pending_ids, pending_ids)
    finally:
        _safe_unlink_db(db_path)


# ======================================================================
# LARGE-T4/T5/T6 + D.2/D.3: retry state machine -- due-time gating, sent/dead
# terminal, sent cannot regress to retry.
# ======================================================================

def test_retry_state_machine():
    print("\n-- LARGE-T4/T5/T6: retry due-time gating, sent/dead terminal --")
    db_path = _make_temp_db(legacy_partner_sent_events=False)
    try:
        ns = build_ns(db_path, max_attempts=5)
        eid = _insert_event(db_path, event_key="ev-retry")

        # A transient (network-classified) failure -> 'retry', with a
        # next_attempt_at in the future.
        ns["_pse_record_failure"](1, eid, ConnectionError("boom"))
        row = _sent_row(db_path, 1, eid)
        check("T4a. transient failure -> send_status='retry'", row["send_status"] == "retry", dict(row))
        check("T4b. next_attempt_at is set (non-empty)", bool(row["next_attempt_at"]), row["next_attempt_at"])

        # T4c: not yet due -> NOT selectable.
        pending = ns["_pending_events_for_source"]("src1", limit=10, user_id=1)
        check("T4c. retry row with future next_attempt_at is NOT selectable yet",
              eid not in [int(r["id"]) for r in pending], [int(r["id"]) for r in pending])

        # Force it due by rewriting next_attempt_at into the past directly
        # (equivalent to time passing).
        con = sqlite3.connect(db_path)
        con.execute("UPDATE partner_sent_events SET next_attempt_at=? WHERE user_id=1 AND event_id=?",
                    ("2000-01-01T00:00:00", eid))
        con.commit()
        con.close()
        pending2 = ns["_pending_events_for_source"]("src1", limit=10, user_id=1)
        check("T4d. retry row past its due next_attempt_at IS selectable",
              eid in [int(r["id"]) for r in pending2], [int(r["id"]) for r in pending2])

        # T5a: bounded attempts -- keep failing transiently until MAX is hit.
        for _ in range(10):
            ns["_pse_record_failure"](1, eid, ConnectionError("boom"))
        row2 = _sent_row(db_path, 1, eid)
        check("T5a. attempts never exceed PARTNER_SENT_MAX_ATTEMPTS(=5)", row2["attempts"] <= 5, row2["attempts"])
        check("T5b. exhausted retry budget -> send_status='dead'", row2["send_status"] == "dead", dict(row2))

        pending3 = ns["_pending_events_for_source"]("src1", limit=10, user_id=1)
        check("T5c. dead event never reselected even after further failure calls",
              eid not in [int(r["id"]) for r in pending3], [int(r["id"]) for r in pending3])

        # T6: sent cannot regress to retry -- record_failure on an already-sent row is a no-op.
        eid2 = _insert_event(db_path, event_key="ev-sent")
        ok = ns["_pse_mark_sent"](2, eid2)
        check("sanity: mark_sent succeeds", ok is True, ok)
        row3 = _sent_row(db_path, 2, eid2)
        check("pre-T6. row is 'sent'", row3["send_status"] == "sent", dict(row3))
        ns["_pse_record_failure"](2, eid2, ConnectionError("late failure after success"))
        row4 = _sent_row(db_path, 2, eid2)
        check("T6. sent state cannot regress to retry/dead via a late failure",
              row4["send_status"] == "sent" and row4["attempts"] == row3["attempts"],
              (dict(row3), dict(row4)))
    finally:
        _safe_unlink_db(db_path)


# ======================================================================
# F-33 / AA: send succeeds, persistence ordering -- _pse_mark_sent runs
# OUTSIDE the send's own try/except and cannot itself trigger a resend.
# ======================================================================

def test_f33_post_send_persistence_ordering():
    print("\n-- F-33/AA: post-send persistence is outside the send's own try --")
    db_path = _make_temp_db(legacy_partner_sent_events=False)
    try:
        eid = _insert_event(db_path, event_key="ev-f33")
        client = _FakeClient()
        ns = build_ns(db_path, client=client)

        msg, fallback_used = run(ns["_pse_send_notification"](
            5, {"id": eid, "manager_key": "mgr1", "manager_display_name": "M", "manager_username": "",
                "chat_id": 1, "username": "u", "full_name": "n", "phone": "",
                "first_seen_utc": "2026-08-12T10:00:00"}, BUYER))
        check("sanity: send succeeded on the first (html) attempt", fallback_used is False, fallback_used)
        check("sanity: no state row exists yet (mark_sent not called)", _sent_row(db_path, 5, eid) is None, None)

        ok = ns["_pse_mark_sent"](5, eid)
        check("F33a. mark_sent (called AFTER send succeeded) persists 'sent'",
              ok is True and _sent_row(db_path, 5, eid)["send_status"] == "sent", ok)

        # Idempotency (1x/2x/10x): repeated mark_sent calls converge, no duplicate rows.
        for _ in range(9):
            ns["_pse_mark_sent"](5, eid)
        con = sqlite3.connect(db_path)
        n_rows = con.execute("SELECT COUNT(*) FROM partner_sent_events WHERE user_id=5 AND event_id=?", (eid,)).fetchone()[0]
        con.close()
        check("F33b. idempotency 1x/2x/10x: exactly one state row after 10 mark_sent calls", n_rows == 1, n_rows)

        # Eligibility: once sent, never reselected -- proves no resend is possible.
        pending = ns["_pending_events_for_source"]("src1", limit=10, user_id=5)
        check("F33c. sent event never reselected (no possible duplicate send)",
              eid not in [int(r["id"]) for r in pending], [int(r["id"]) for r in pending])
    finally:
        _safe_unlink_db(db_path)


# ======================================================================
# HTML escaping: the actual root-cause fix for F-31 (default Telethon
# Markdown parser choking on raw '_'/'*'/'`' in dynamic fields).
# ======================================================================

def test_html_escaping():
    print("\n-- HTML escaping: dynamic fields are escaped, primary attempt uses parse_mode='html' --")
    db_path = _make_temp_db(legacy_partner_sent_events=False)
    try:
        ns = build_ns(db_path)
        row = {
            "manager_key": "mgr1", "manager_display_name": "M<gr>", "manager_username": "",
            "chat_id": 1, "username": "a&b", "full_name": "<script>x</script>", "phone": "",
            "first_seen_utc": "2026-08-12T10:00:00",
        }
        html_text = ns["_pse_fmt_lead_notification_html"](row, BUYER)
        check("H1. '<script>' in full_name is escaped in the html-mode text",
              "<script>" not in html_text and "&lt;script&gt;" in html_text, html_text)
        check("H2. '&' in username is escaped", "a&b" not in html_text and "a&amp;b" in html_text, html_text)

        client = _FakeClient()
        ns2 = build_ns(db_path, client=client)
        run(ns2["_pse_send_notification"](7, dict(row, id=1), BUYER))
        check("H3. primary send attempt is made with parse_mode='html' explicitly",
              client.calls[0]["parse_mode"] == "html" and client.calls[0]["parse_mode_explicit"], client.calls[0])
    finally:
        _safe_unlink_db(db_path)


# ======================================================================
# Error classification: terminal recipient / floodwait / db-busy.
# ======================================================================

def test_error_classification():
    print("\n-- Error classification: terminal recipient / floodwait / db-busy --")
    db_path = _make_temp_db(legacy_partner_sent_events=False)
    ns = build_ns(db_path)
    try:
        c1 = ns["_pse_classify_error"](_UserIsBlockedError("blocked"))
        check("C1. UserIsBlockedError classified terminal", c1["terminal"] is True, c1)

        c2 = ns["_pse_classify_error"](_FloodWaitError(120))
        check("C2. FloodWaitError classified non-terminal with cooldown_seconds=120",
              c2["terminal"] is False and c2["cooldown_seconds"] == 120, c2)

        db_exc = sqlite3.OperationalError("database is locked")
        c3 = ns["_pse_classify_error"](db_exc)
        check("C3. sqlite3 'database is locked' classified non-terminal transient_db_busy",
              c3["terminal"] is False and c3["category"] == "transient_db_busy", c3)

        c4 = ns["_pse_classify_error"](RuntimeError("something else"))
        check("C4. unknown exception classified non-terminal (bounded retry, not instant dead)",
              c4["terminal"] is False, c4)
    finally:
        _safe_unlink_db(db_path)


