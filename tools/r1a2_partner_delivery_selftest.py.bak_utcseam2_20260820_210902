class _FakeButton:
    @staticmethod
    def inline(text, data=None):
        return {"text": text, "data": data}


class _FakeMsg:
    def __init__(self, id_: int):
        self.id = id_


_UNSET = object()


class _FakeClient:
    """Scriptable fake of the Telethon client's send_message -- records
    every call (including the exact parse_mode argument, so a test can prove
    the plain-text fallback really used parse_mode=None) and can be told to
    fail on the Nth call with a specific exception."""

    def __init__(self):
        self.calls: List[dict] = []
        self._next_id = 1
        self._fail_on_call: Dict[int, BaseException] = {}

    def fail_on(self, call_number: int, exc: BaseException) -> None:
        self._fail_on_call[call_number] = exc

    def fail_always(self, exc_factory) -> None:
        self._fail_always = exc_factory

    async def send_message(self, chat_id, text, buttons=None, parse_mode=_UNSET):
        n = len(self.calls) + 1
        self.calls.append({"chat_id": chat_id, "text": text, "buttons": buttons,
                            "parse_mode": (None if parse_mode is _UNSET else parse_mode),
                            "parse_mode_explicit": parse_mode is not _UNSET})
        fail_always = getattr(self, "_fail_always", None)
        if fail_always is not None:
            raise fail_always()
        if n in self._fail_on_call:
            raise self._fail_on_call[n]
        msg = _FakeMsg(self._next_id)
        self._next_id += 1
        return msg


class _NullLogger:
    def info(self, *a, **k): pass
    def warning(self, *a, **k): pass


def build_ns(db_path: str, *, client=None, max_attempts: int = 3):
    nodes = [_last_def(name) if name not in ("PARTNER_SENT_MAX_ATTEMPTS",) else None for name in DELIVERY_NAMES]
    func_names = [n for n in DELIVERY_NAMES if n != "PARTNER_SENT_MAX_ATTEMPTS"]
    nodes = [_last_def(n) for n in func_names]
    module_src = "\n\n".join(ast.unparse(n) for n in nodes)

    ns: Dict[str, Any] = {
        "sqlite3": sqlite3,
        "random": real_random,
        "re": re,
        "time": real_time,
        "Path": Path,
        "datetime": datetime,
        "timedelta": timedelta,
        "timezone": timezone,
        "os": os,
        "Any": object, "Dict": dict, "List": list, "Tuple": tuple, "Optional": Optional,
        "TPILOT_DB_PATH": db_path,
        "PARTNER_SENT_MAX_ATTEMPTS": max_attempts,
        "client": client or _FakeClient(),
        "Button": _FakeButton,
        "print": print,
        "_partner_current_or_snapshot_identity": lambda mk, dn, un: (dn or "TestManager", un or "testmgr"),
        "_html": real_html,
        "TZ": ZoneInfo("Europe/Kyiv"),
        "_kyiv_now": lambda: datetime.now(ZoneInfo("Europe/Kyiv")),
        # The active _ensure_tables override chains to this captured "original"
        # (partner_buyers/partner_access_requests/... bootstrap, main._ensure_tables
        # at line 74) -- unrelated to the R1A2 fix under test here, so it's a
        # boundary fake (None -> the `if callable(...)` guard skips it, same as
        # MANAGER_BOT_SEND_MAX_ATTEMPTS is faked in manager_bot_delivery_selftest.py).
        "_TP_PARTNER_CI_ORIG_ENSURE_TABLES": None,
    }
    # utcnow refactor stage 2 (2026-08-16): extracted prod code may read the
    # clock through per-module naive-UTC seams. Bind every seam name that
    # could appear (main/manager_bot/partner_stat_bot/panel_bridge) with
    # setdefault so a test-controlled fake clock is never overwritten.
    for _seam in ("_tp_utc_now", "_mbot_utc_now", "_psb_utc_now", "_pbr_utc_now"):
        ns.setdefault(_seam, lambda: __import__("datetime").datetime.now(
            __import__("datetime").timezone.utc).replace(tzinfo=None))
    exec(compile(module_src, f"<{PSB_PATH}:r1a2>", "exec"), ns)
    return ns


def _make_temp_db(*, legacy_partner_sent_events: bool = True) -> str:
    """Pre-migration legacy schema (partner_lead_events already has the R1A1
    contact-identity columns -- that migration is not under test here;
    partner_sent_events is the bare PK-only legacy table). The R1A2 migration
    itself (ALTER TABLE ADD COLUMN for send_status/attempts/next_attempt_at/
    last_error_class) is exercised for real by calling the extracted
    _ensure_tables() in the tests below, against this exact pre-migration
    shape -- same convention as manager_bot_delivery_selftest.py's own
    _make_temp_db docstring."""
    fd, path = tempfile.mkstemp(suffix=".db", prefix="r1a2_partner_delivery_selftest_")
    os.close(fd)
    con = sqlite3.connect(path)
    try:
        con.executescript(
            """
            CREATE TABLE partner_lead_events(
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                event_key TEXT UNIQUE NOT NULL DEFAULT '',
                source_key TEXT NOT NULL DEFAULT '',
                manager_key TEXT NOT NULL DEFAULT '',
                manager_display_name TEXT DEFAULT '',
                manager_username TEXT DEFAULT '',
                lead_id INTEGER NOT NULL DEFAULT 0,
                chat_id INTEGER NOT NULL DEFAULT 0,
                username TEXT DEFAULT '',
                full_name TEXT DEFAULT '',
                phone TEXT DEFAULT '',
                first_seen_utc TEXT NOT NULL DEFAULT '',
                duplicate INTEGER NOT NULL DEFAULT 0,
                known_contact_id INTEGER NOT NULL DEFAULT 0,
                contact_kind TEXT NOT NULL DEFAULT 'new',
                lead_countable INTEGER NOT NULL DEFAULT 1,
                dedupe_reason TEXT NOT NULL DEFAULT '',
                first_seen_global_at TEXT NOT NULL DEFAULT '',
                first_seen_global_manager_key TEXT NOT NULL DEFAULT '',
                created_at TEXT NOT NULL DEFAULT '',
                updated_at TEXT NOT NULL DEFAULT ''
            );
            """
        )
        if legacy_partner_sent_events:
            con.executescript(
                """
                CREATE TABLE partner_sent_events(
                    user_id INTEGER NOT NULL,
                    event_id INTEGER NOT NULL,
                    sent_at TEXT NOT NULL DEFAULT '',
                    PRIMARY KEY(user_id, event_id)
                );
                """
            )
        else:
            con.executescript(
                """
                CREATE TABLE partner_sent_events(
                    user_id INTEGER NOT NULL,
                    event_id INTEGER NOT NULL,
                    sent_at TEXT NOT NULL DEFAULT '',
                    attempts INTEGER NOT NULL DEFAULT 0,
                    next_attempt_at TEXT NOT NULL DEFAULT '',
                    send_status TEXT NOT NULL DEFAULT 'sent',
                    last_error_class TEXT NOT NULL DEFAULT '',
                    PRIMARY KEY(user_id, event_id)
                );
                """
            )
        con.commit()
    finally:
        con.close()
    return path


def _insert_event(db_path: str, **kwargs) -> int:
    defaults = dict(
        event_key=f"ek-{kwargs.get('id', real_random.randint(1, 10**9))}",
        source_key="src1", manager_key="mgr1", manager_display_name="Manager One",
        manager_username="mgr1_un", chat_id=111, username="leaduser",
        full_name="Lead Name", phone="+100", first_seen_utc="2026-08-12T10:00:00",
        duplicate=0, lead_countable=1, contact_kind="new", created_at="2026-08-12T10:00:00",
        updated_at="2026-08-12T10:00:00",
    )
    defaults.update(kwargs)
    con = sqlite3.connect(db_path)
    try:
        cur = con.execute(
            """
            INSERT INTO partner_lead_events(
                event_key, source_key, manager_key, manager_display_name, manager_username,
                chat_id, username, full_name, phone, first_seen_utc, duplicate,
                lead_countable, contact_kind, created_at, updated_at
            ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
            """,
            (defaults["event_key"], defaults["source_key"], defaults["manager_key"],
             defaults["manager_display_name"], defaults["manager_username"], defaults["chat_id"],
             defaults["username"], defaults["full_name"], defaults["phone"],
             defaults["first_seen_utc"], defaults["duplicate"], defaults["lead_countable"],
             defaults["contact_kind"], defaults["created_at"], defaults["updated_at"]),
        )
        con.commit()
        return int(cur.lastrowid)
    finally:
        con.close()


def _safe_unlink_db(db_path: str) -> None:
    """Best-effort cleanup -- WAL mode (set by the real _connect()) can leave
    -wal/-shm sidecars briefly held on Windows even after every connection is
    closed; a cleanup failure here is a test-harness hygiene issue, never a
    reason to fail the actual assertions above it (same ignore_errors
    convention as tools/r1a1_correctness_selftest.py's cleanup_dir)."""
    for suffix in ("", "-wal", "-shm"):
        try:
            os.unlink(db_path + suffix)
        except Exception:
            pass


def _sent_row(db_path: str, user_id: int, event_id: int) -> Optional[sqlite3.Row]:
    con = sqlite3.connect(db_path)
    con.row_factory = sqlite3.Row
    try:
        return con.execute(
            "SELECT * FROM partner_sent_events WHERE user_id=? AND event_id=?",
            (user_id, event_id),
        ).fetchone()
    finally:
        con.close()


