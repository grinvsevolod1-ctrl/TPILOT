def _last_def(name: str):
    """Returns the LAST top-level def/assignment of `name` (this project's
    override-stacking convention: only the last definition is active) --
    works for FunctionDef/AsyncFunctionDef AND simple Assign/AnnAssign
    (needed for the module-level frozenset/tuple constants alongside the
    functions), same technique as r1a1_correctness_selftest.py's
    extract_and_exec."""
    node = None
    for n in PSB_TREE.body:
        target_name = None
        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)):
            target_name = n.name
        elif isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name):
            target_name = n.targets[0].id
        elif isinstance(n, ast.AnnAssign) and isinstance(n.target, ast.Name):
            target_name = n.target.id
        if target_name == name:
            node = n
    if node is None:
        raise AssertionError(f"no def/assign {name} found in partner_stat_bot.py")
    return node


