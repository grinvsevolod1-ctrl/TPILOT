def extract_and_exec(path: Path, names: set, extra_ns: dict) -> dict:
    """AST-extract the LAST (active) top-level def/assignment of each
    requested name -- this project's own override-stacking convention (see
    CLAUDE.md: "only the LAST definition is active") -- and exec into a seeded
    namespace. Same technique as tools/deleted_manager_stats_retention_selftest.py
    and tools/identity_consumers_selftest.py."""
    src = path.read_text(encoding="utf-8-sig")
    tree = ast.parse(src)
    picked: Dict[str, Any] = {}
    for node in tree.body:
        target_name = None
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            target_name = node.name
        elif isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
            target_name = node.targets[0].id
        elif isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name):
            target_name = node.target.id
        if target_name in names:
            picked[target_name] = node  # later defs overwrite earlier -> last wins
    missing = names - set(picked)
    if missing:
        raise AssertionError(f"could not find {missing} as top-level defs/assignments in {path}")
    module_src = "\n\n".join(ast.unparse(picked[n]) for n in sorted(picked))
    ns = dict(extra_ns)
    # utcnow refactor stage 2 (2026-08-16): extracted prod code may read the
    # clock through per-module naive-UTC seams. Bind every seam name that
    # could appear (main/manager_bot/partner_stat_bot/panel_bridge) with
    # setdefault so a test-controlled fake clock is never overwritten.
    for _seam in ("_tp_utc_now", "_mbot_utc_now", "_psb_utc_now", "_pbr_utc_now"):
        ns.setdefault(_seam, lambda: __import__("datetime").datetime.now(
            __import__("datetime").timezone.utc).replace(tzinfo=None))
    exec(compile(module_src, f"<{path.name}:r1a1>", "exec"), ns)
    return ns


async def make_temp_dir(prefix: str) -> Path:
    return Path(tempfile.mkdtemp(prefix=prefix))


async def cleanup_dir(tmp_root: Path) -> None:
    try:
