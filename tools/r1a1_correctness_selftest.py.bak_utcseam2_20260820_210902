def _active_create_partner_lead_event_src(src: str) -> str:
    """Returns the unparsed source of the ACTIVE (last-defined, per this
    project's override-stacking convention) _create_partner_lead_event_from_daily."""
    tree = ast.parse(src)
    last_node = None
    for node in tree.body:
        if isinstance(node, ast.AsyncFunctionDef) and node.name == "_create_partner_lead_event_from_daily":
            last_node = node
    assert last_node is not None, "_create_partner_lead_event_from_daily not found"
    return ast.unparse(last_node)


