async def test_t1_live_countability_gate():
    print("\n-- T1 (F-19): _mb_enqueue_after_pipeline countability gate --")
    calls = {"insert_event": [], "duplicate": []}

    async def fake_fetch_noncountable(chat_id):
        return {"id": 5, "chat_id": chat_id, "manager_key": "mgr1", "lead_date": "2026-08-12", "lead_countable": 0}

    async def fake_insert_event(row):
        calls["insert_event"].append(dict(row))

    async def fake_duplicate_after_pipeline(chat_id):
        calls["duplicate"].append(int(chat_id))

    ns = extract_and_exec(
        MAIN_PY, {"_mb_enqueue_after_pipeline"},
        {
            "_mb_fetch_daily_row_after_pipeline": fake_fetch_noncountable,
            "_mb_insert_event": fake_insert_event,
            "_mb_enqueue_duplicate_after_pipeline": fake_duplicate_after_pipeline,
            "print": print,
        },
    )
    await ns["_mb_enqueue_after_pipeline"](12345)
    check("T1a. non-countable row (lead_countable=0) does NOT produce an ordinary lead_card",
          calls["insert_event"] == [], calls["insert_event"])
    check("T1b. non-countable row falls through to the duplicate_card path instead",
          calls["duplicate"] == [12345], calls["duplicate"])

    # Regression: a genuinely countable row must still take the normal path unchanged.
    calls2 = {"insert_event": [], "duplicate": []}

    async def fake_fetch_countable(chat_id):
        return {"id": 7, "chat_id": chat_id, "manager_key": "mgr1", "lead_date": "2026-08-12", "lead_countable": 1}

    ns2 = extract_and_exec(
        MAIN_PY, {"_mb_enqueue_after_pipeline"},
        {
            "_mb_fetch_daily_row_after_pipeline": fake_fetch_countable,
            "_mb_insert_event": (lambda row: calls2["insert_event"].append(dict(row)) or _async_noop()),
            "_mb_enqueue_duplicate_after_pipeline": (lambda chat_id: calls2["duplicate"].append(int(chat_id)) or _async_noop()),
            "print": print,
        },
    )
    await ns2["_mb_enqueue_after_pipeline"](999)
    check("T1c. [regression] a countable row (lead_countable=1, id>0) still produces the ordinary lead_card",
          len(calls2["insert_event"]) == 1 and calls2["insert_event"][0]["id"] == 7, calls2["insert_event"])
    check("T1d. [regression] a countable row does NOT fall through to the duplicate path",
          calls2["duplicate"] == [], calls2["duplicate"])

    # id<=0 must also be treated as non-countable (structural guard, mirrors catch-up).
    calls3 = {"insert_event": [], "duplicate": []}

    async def fake_fetch_zero_id(chat_id):
        return {"id": 0, "chat_id": chat_id, "manager_key": "mgr1", "lead_date": "2026-08-12", "lead_countable": 1}

    ns3 = extract_and_exec(
        MAIN_PY, {"_mb_enqueue_after_pipeline"},
        {
            "_mb_fetch_daily_row_after_pipeline": fake_fetch_zero_id,
            "_mb_insert_event": (lambda row: calls3["insert_event"].append(dict(row)) or _async_noop()),
            "_mb_enqueue_duplicate_after_pipeline": (lambda chat_id: calls3["duplicate"].append(int(chat_id)) or _async_noop()),
            "print": print,
        },
    )
    await ns3["_mb_enqueue_after_pipeline"](111)
    check("T1e. id<=0 is also rejected by the gate even if lead_countable=1 (structural guard)",
          calls3["insert_event"] == [] and calls3["duplicate"] == [111], (calls3["insert_event"], calls3["duplicate"]))


