# B3-T1..T13 (B-3 FINAL, second independent review) -- BUSINESS-BEHAVIOR proof.
#
# The previous C7/C8/C9 generation only proved
#     _mb_stats_authoritative_db_path(k) == stats_engine.se_manager_db_path(row)
# i.e. a resolver compared against the resolver it delegates to -- structurally
# unable to fail no matter how the write and read paths diverge. An independent
# review proved they DO diverge for a deleted manager and that divergence
# produced exactly the forbidden state (write reports True, the DB the live
# /stat feature reads was never touched). Every test below instead observes:
#   (1) the write's boolean result,
#   (2) the actual bytes on disk of the physical DB the writer chose, and
#   (3) an INDEPENDENT reconstruction of the live /stat read path
#       (real_stat_readback, above) -- not a re-SELECT of the writer's own
#       target DB.
# The hard invariant under test everywhere: _apply_manual_status(...) is True
# implies real_stat_readback(...) sees the new status. No exceptions.
# ======================================================================

def _mk_registry(managers_db: str, rows) -> None:
    con = sqlite3.connect(managers_db)
    con.executescript(MANAGERS_DDL)
    for mk, disp, tg, db_path in rows:
        con.execute("INSERT INTO managers(manager_key, display_name, telegram_username, db_path) VALUES(?,?,?,?)",
                    (mk, disp, tg, db_path))
    con.commit()
    con.close()


