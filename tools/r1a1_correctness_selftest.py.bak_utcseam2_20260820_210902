def extract_and_exec_optional(path: Path, required: set, optional: set, extra_ns: dict) -> dict:
    """Like extract_and_exec, but `optional` names are pulled in only if the
    source file actually defines them -- silently skipped otherwise. Used so
    the SAME B-3 namespace-builder works against both the corrected
    manager_bot.py (which has the new helpers) and a pre-fix backup (which
    doesn't), for a genuine RED-before-fix / GREEN-after-fix comparison."""
    src = path.read_text(encoding="utf-8-sig")
    tree = ast.parse(src)
    present_optional = set()
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name in optional:
            present_optional.add(node.name)
    return extract_and_exec(path, required | present_optional, extra_ns)


