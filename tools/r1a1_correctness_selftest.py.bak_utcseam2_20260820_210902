# ======================================================================
# ADV-14 (third independent review) -- registry-read failure must never be
# mistaken for "manager row genuinely absent".
#
# Forbidden state reproduced by the reviewer against the pre-ADV14 file:
#   managers.db_path = DB_A, canonical fallback = DB_B, BOTH exist, the central
#   registry is unreadable at the moment the writer resolves its target ->
#   _mbstat_manager_row swallowed the error and returned {}, so the resolver
#   guessed the canonical DB_B, wrote it, and returned True; once the registry
#   recovered, the live /stat path resolved DB_A and showed stale data.
#
# Every check below is behavioral: it drives the REAL active _apply_manual_status
# and reads back through real_stat_readback (the real live /stat chain).
# ======================================================================

def _adv14_read_status(db_path: str, chat_id: int = 1):
    con = sqlite3.connect(db_path)
    try:
        r = con.execute(
            "SELECT manual_status_override, quality_bucket FROM daily_leads WHERE chat_id=? LIMIT 1",
            (int(chat_id),),
        ).fetchone()
        return (int(r[0] or 0), str(r[1] or "")) if r else None
    except Exception:
        return None
    finally:
        con.close()


class _RegistryUnreadable:
    """Makes the central registry DB genuinely unreadable by sqlite (not a mock):
    the file's bytes are replaced, so every read raises DatabaseError exactly the
    way a corrupt/torn control-plane DB does in production. Restored on exit, so
    the live /stat readback afterwards runs against a healthy registry -- which
    is precisely what makes the writer/reader split observable."""

    def __init__(self, path: str):
        self._path = Path(path)

    def __enter__(self):
        self._good = self._path.read_bytes()
        self._path.write_bytes(b"NOT A SQLITE DATABASE" + b"\x00" * 256)
        return self

    def __exit__(self, *exc):
        self._path.write_bytes(self._good)
        return False


