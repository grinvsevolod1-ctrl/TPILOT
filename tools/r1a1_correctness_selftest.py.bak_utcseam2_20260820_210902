def real_stat_readback(ns: dict, manager_key: str, chat_id: int, lead_date: str):
    """Independently reproduces the ACTIVE ManagerBot /stat read path -- NOT a
    re-check of whichever DB the writer happened to pick.

    The live chain is: `_mbstat_manager_rows_for_user` builds
    `row = dict(_mbstat_manager_row(mk)); row["manager_key"] = mk`, then the
    Stage-4D-wired `_mbstat_light_body`/`_mbstat_window_body` (the ACTIVE
    overrides -- see manager_bot.py's own
    '# --- TPILOT STAGE 4D: Wire ManagerBot stats bodies to stats_engine ---'
    block, which shadows the earlier pre-Stage-4D bodies) call
    `stats_engine.se_light_body`/`se_window_body`, whose DEFAULT
    `leads_provider` is `stats_engine.se_leads_for_manager(row, dates)`.

    This helper performs exactly that chain against the REAL `stats_engine`
    module (imported at the top of this file, not a mock) and returns the
    matching `daily_leads` row if the live reader would surface it, `None` if
    it plainly wouldn't, or the string "UNAVAILABLE" if the reader would show
    the F-25 unavailable marker instead of a confirmed absence."""
    mk = ns["_norm_key"](manager_key)
    reg_row = ns["_mbstat_manager_row"](mk)
    row = dict(reg_row or {})
    row["manager_key"] = mk
    leads = stats_engine.se_leads_for_manager(row, [str(lead_date)])
    if isinstance(leads, stats_engine.SeLeadsUnavailable):
        return "UNAVAILABLE"
    for lead in leads:
        if int(lead.get("chat_id") or 0) == int(chat_id):
            return lead
    return None


class _StatsEngineBaseDirOverride:
    """Context manager that temporarily repoints the REAL `stats_engine.BASE_DIR`
    at a temp root, so a test can exercise the module's actual fallback-path
    formula (`BASE_DIR/runtime/managers/<mk>/<mk>.db`) without writing into the
    real project tree at C:\\ALM_TPilot\\runtime\\managers\\. Both the writer
    (`_mb_stats_authoritative_db_path` -> `stats_engine.se_manager_db_path`) and
    `real_stat_readback` (-> `stats_engine.se_leads_for_manager` ->
    `se_manager_db_path`) go through this SAME module attribute, so both sides
    see the same temp root consistently. Restored unconditionally on exit."""

    def __init__(self, new_base_dir: Path):
        self._new = new_base_dir

    def __enter__(self):
        self._prev = stats_engine.BASE_DIR
        stats_engine.BASE_DIR = self._new
        return self

    def __exit__(self, *exc):
        stats_engine.BASE_DIR = self._prev
        return False


class _StatsEngineImportDisabled:
    """Context manager that makes `import stats_engine` raise ImportError from
    WITHIN the AST-extracted `_mb_stats_authoritative_db_path` body, to exercise
    its degraded-mode branch (stats_engine unimportable -- e.g. Stage 4D wiring
    never took effect) without touching the real module object other tests in
    this same process still rely on."""

    def __enter__(self):
        self._prev = sys.modules.get("stats_engine", "__ABSENT__")
        sys.modules["stats_engine"] = None
        return self

    def __exit__(self, *exc):
        if self._prev == "__ABSENT__":
            sys.modules.pop("stats_engine", None)
        else:
            sys.modules["stats_engine"] = self._prev
        return False


