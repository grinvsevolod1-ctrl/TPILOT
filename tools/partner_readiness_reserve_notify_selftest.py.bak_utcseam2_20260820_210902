async def test_r1_r2_first_sends_store_slots():
    print("\n-- Group R: first sends store per-slot references --")
    tmp_root, db_path = make_temp_env("readiness_r1_")
    ns = build_readiness_ns(db_path)
    try:
        await ns["_pf_send_partner_report"](11001, "2026-07-17", "today", "Morning report text")
        morning_ref = ns["_pf_get_setting"]("preflight_msg_partner_today_11001")
        check("R1. first morning send stores the morning slot", bool(morning_ref) and morning_ref.split(":")[0] == "2026-07-17", morning_ref)

        await ns["_pf_send_partner_report"](11001, "2026-07-17", "tomorrow", "Evening report text")
        evening_ref = ns["_pf_get_setting"]("preflight_msg_partner_tomorrow_11001")
        check("R2. first evening send stores the evening slot", bool(evening_ref), evening_ref)
        check("R2b. morning and evening slots are independent keys with independent values", morning_ref != evening_ref, (morning_ref, evening_ref))
    finally:
        cleanup_env(tmp_root)


async def test_r3_r4_second_send_deletes_only_same_slot():
    print("\n-- Group R: second send deletes only its own slot --")
    tmp_root, db_path = make_temp_env("readiness_r3_")
    ns = build_readiness_ns(db_path)
    try:
        await ns["_pf_send_partner_report"](11002, "2026-07-16", "today", "Evening #1")  # deliberately out of A/B example order to mirror the user's own worked example
        await ns["_pf_send_partner_report"](11002, "2026-07-16", "tomorrow", "Evening #1 text")
        evening1_mid = int(ns["_pf_get_setting"]("preflight_msg_partner_tomorrow_11002").split(":")[1])

        await ns["_pf_send_partner_report"](11002, "2026-07-17", "today", "Morning #1 text")
        morning1_ref = ns["_pf_get_setting"]("preflight_msg_partner_today_11002")

        await ns["_pf_send_partner_report"](11002, "2026-07-17", "tomorrow", "Evening #2 text")
        deletes = [c for c in ns["__client__"].calls if c[0] == "delete_messages"]
        check("R3-setup(worked example). Evening #1 deleted when Evening #2 is sent", any(c[1] == 11002 and evening1_mid in c[2] for c in deletes), deletes)
        check("R3-setup(worked example). Morning #1 untouched by Evening #2", ns["_pf_get_setting"]("preflight_msg_partner_today_11002") == morning1_ref, None)

        await ns["_pf_send_partner_report"](11002, "2026-07-18", "today", "Morning #2 text")
        deletes2 = [c for c in ns["__client__"].calls if c[0] == "delete_messages"]
        morning1_mid = int(morning1_ref.split(":")[1])
        check("R3. Morning #2 deletes only Morning #1 (not the current evening message)", any(c[1] == 11002 and morning1_mid in c[2] for c in deletes2), deletes2)
        evening2_ref = ns["_pf_get_setting"]("preflight_msg_partner_tomorrow_11002")
        evening2_mid = int(evening2_ref.split(":")[1])
        check("R4. Evening #2 remains untouched after Morning #2", not any(c[1] == 11002 and evening2_mid in c[2] for c in deletes2), deletes2)
    finally:
        cleanup_env(tmp_root)


