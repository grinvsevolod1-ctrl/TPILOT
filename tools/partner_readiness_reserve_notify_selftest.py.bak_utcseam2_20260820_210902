def _fake_report_is_ok(report):
    return bool(report) and bool(report.get("ok"))


def build_readiness_ns(db_path: str) -> dict:
    _selftest_db_guard(db_path, BASE_DIR, _storage_module)
    nodes = _extract_by_names(PARTNER_SRC, READINESS_NAMES)
    module_src = "\n\n".join(ast.unparse(n) for n in nodes)
    client = FakeClient()
    ns = {
        "os": os,
        "re": __import__("re"),
        "asyncio": asyncio,
        "sqlite3": sqlite3,
        "TPILOT_DB_PATH": db_path,
        "Button": FakeButton,
        "events": FakeEventsNS,
        "client": client,
        "Dict": dict, "Any": object, "List": list, "Optional": None, "Tuple": tuple,
        "_pf_report_is_ok": _fake_report_is_ok,
    }
    # utcnow refactor stage 2 (2026-08-16): extracted prod code may read the
    # clock through per-module naive-UTC seams. Bind every seam name that
    # could appear (main/manager_bot/partner_stat_bot/panel_bridge) with
    # setdefault so a test-controlled fake clock is never overwritten.
    for _seam in ("_tp_utc_now", "_mbot_utc_now", "_psb_utc_now", "_pbr_utc_now"):
        ns.setdefault(_seam, lambda: __import__("datetime").datetime.now(
            __import__("datetime").timezone.utc).replace(tzinfo=None))
    exec(compile(module_src, f"<{PARTNER_PATH}:readiness>", "exec"), ns)
    ns["__client__"] = client
    return ns


def build_reserve_ns(db_path: str) -> dict:
    _selftest_db_guard(db_path, BASE_DIR, _storage_module)
    _storage_module.ensure_reserve_tables(db_path)
    nodes = _extract_by_names(PARTNER_SRC, RESERVE_NAMES)
    module_src = "\n\n".join(ast.unparse(n) for n in nodes)
    client = FakeClient()
    ns = {
        "os": os,
        "re": __import__("re"),
        "asyncio": asyncio,
        "sqlite3": sqlite3,
        "datetime": datetime,
        "timedelta": timedelta,
        "timezone": timezone,
        "TPILOT_DB_PATH": db_path,
        "storage": _storage_module,
        "Button": FakeButton,
        "events": FakeEventsNS,
        "client": client,
        "Dict": dict, "Any": object, "List": list, "Optional": None, "Tuple": tuple,
        # _enabled_buyers() (real, unmodified) calls the real _ensure_tables()
        # first -- that function creates the project's FULL PartnerBot schema
        # (many unrelated tables), well outside this test's scope to
        # re-extract. Fixtures below (seed_buyer/seed_manager/
        # ensure_reserve_tables) already create every table this test
        # actually needs, so a no-op stand-in is sufficient and matches the
        # same convention other selftests use for large schema bootstraps.
        "_ensure_tables": lambda: None,
    }
    # utcnow refactor stage 2 (2026-08-16): extracted prod code may read the
    # clock through per-module naive-UTC seams. Bind every seam name that
    # could appear (main/manager_bot/partner_stat_bot/panel_bridge) with
    # setdefault so a test-controlled fake clock is never overwritten.
    for _seam in ("_tp_utc_now", "_mbot_utc_now", "_psb_utc_now", "_pbr_utc_now"):
        ns.setdefault(_seam, lambda: __import__("datetime").datetime.now(
            __import__("datetime").timezone.utc).replace(tzinfo=None))
    exec(compile(module_src, f"<{PARTNER_PATH}:reserve>", "exec"), ns)
    ns["__client__"] = client
    ns["__storage__"] = _storage_module
    return ns


