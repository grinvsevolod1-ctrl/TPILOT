def _iso(dt: datetime) -> str:
    """Same naive-UTC-no-microseconds format storage.py's own _now_iso()
    writes -- every fixture below deliberately matches it so the SQL-level
    string-comparison bounds in the real _rsvan_done_events_for_source stay
    correct against seeded data, exactly as they do against real rows."""
    return dt.replace(microsecond=0).isoformat()


def utc_now() -> datetime:
    return datetime.now(__import__("datetime").timezone.utc).replace(tzinfo=None)


def seed_reserve_event(db_path: str, *, source_key: str, primary_key: str, reserve_key: str,
                        target_date: str = "2026-07-17", status: str = "done",
                        updated_at: str = None) -> int:
    """updated_at defaults to "now" (matching a real fresh completion) --
    pass an explicit ISO string (see _iso/utc_now) to place an event at a
    specific point in the freshness window for boundary tests."""
    _storage_module.ensure_reserve_tables(db_path)
    ts = updated_at if updated_at is not None else _iso(utc_now())
    con = sqlite3.connect(db_path)
    try:
        cur = con.execute(
            "INSERT INTO reserve_activation_events"
            "(source_key, primary_key, reserve_key, target_date, requested_by_user_id, status, created_at, updated_at)"
            " VALUES(?,?,?,?,?,?,?,?)",
            (source_key, primary_key, reserve_key, target_date, 1, status, ts, ts),
        )
        con.commit()
        return int(cur.lastrowid)
    finally:
        con.close()


def prime_baseline(db_path: str, ts: str = None) -> None:
    """Simulates 'the timestamp baseline guard already ran in an earlier
    process lifetime, at this UTC instant' -- lets a test seed+sweep a
    'done' event dated after that instant and have it correctly treated as
    live/new, matching the real production sequence (deploy -> first-ever
    sweep initializes rsvan_baseline_updated_at against "now" -> genuinely
    NEW completions after that point get notified). Defaults to 1 second
    before "now" so a subsequently-seeded event (also defaulting to "now")
    is unambiguously after it. Writes directly to the settings table so it
    can be called either before or after build_reserve_ns."""
    value = ts if ts is not None else _iso(utc_now() - timedelta(seconds=1))
    con = sqlite3.connect(db_path)
    try:
        con.execute("CREATE TABLE IF NOT EXISTS settings(key TEXT PRIMARY KEY, value TEXT NOT NULL DEFAULT '')")
        con.execute(
            "INSERT INTO settings(key, value) VALUES('rsvan_baseline_updated_at', ?) "
            "ON CONFLICT(key) DO UPDATE SET value=excluded.value",
            (value,),
        )
        con.commit()
    finally:
        con.close()


def set_event_status(db_path: str, event_id: int, status: str, *, updated_at: str = None) -> None:
    """Mirrors storage.reserve_activation_finish's own exact column set:
    flips status AND refreshes updated_at together (a real status
    transition always touches both)."""
    ts = updated_at if updated_at is not None else _iso(utc_now())
    con = sqlite3.connect(db_path)
    try:
        con.execute("UPDATE reserve_activation_events SET status=?, updated_at=? WHERE id=?", (status, ts, event_id))
        con.commit()
    finally:
        con.close()


