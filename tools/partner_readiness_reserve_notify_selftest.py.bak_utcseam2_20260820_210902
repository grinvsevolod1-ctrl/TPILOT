async def test_w6_failed_recipient_retried_not_permanently_skipped():
    print("\n-- Group W: one recipient's send failure is retried, never permanently skipped by baseline logic --")
    tmp_root, db_path = make_temp_env("reserve_w6_")
    ns = build_reserve_ns(db_path)
    try:
        seed_buyer(db_path, user_id=13006, source_key="srcw6")
        seed_buyer(db_path, user_id=13007, source_key="srcw6")
        await ns["_rsvan_sweep_source"]("srcw6", [13006, 13007])  # baseline init, no history

        eid = seed_reserve_event(db_path, source_key="srcw6", primary_key="pW6", reserve_key="rW6", status="done")
        ns["__client__"].send_fail_uids.add(13006)
        await ns["_rsvan_sweep_source"]("srcw6", [13006, 13007])
        # NOTE: FakeClient.send_message records EVERY attempt (including
        # ones that then raise) into .calls -- the persisted rsvan_sent_
        # dedup flag, not raw call presence, is the actual signal for
        # "was this recipient durably marked delivered" (matches
        # production: _rsvan_send_one only sets the flag AFTER a
        # confirmed successful send).
        check("W6a/W30a. the failing recipient's failure does not block the other recipient", bool(ns["_pf_get_setting"](f"rsvan_sent_{eid}_13007")), None)
        check("W6b/W30b. the failing recipient is not marked as sent", ns["_pf_get_setting"](f"rsvan_sent_{eid}_13006") == "", None)

        ns["__client__"].send_fail_uids.discard(13006)
        calls_before_retry = list(ns["__client__"].calls)
        await ns["_rsvan_sweep_source"]("srcw6", [13006, 13007])
        new_calls = [c for c in ns["__client__"].calls if c not in calls_before_retry and c[0] == "send_message"]
        check("W6c/W30c. the previously-failing recipient IS delivered on a later sweep, still within 72h (baseline logic never permanently skips it)", bool(ns["_pf_get_setting"](f"rsvan_sent_{eid}_13006")), None)
        check("W6d/W31. the already-delivered recipient gets no NEW send attempt this sweep (dedup skip, not just dedup success)", not any(c[1] == 13007 for c in new_calls), new_calls)
    finally:
        cleanup_env(tmp_root)


