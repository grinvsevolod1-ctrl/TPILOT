async def test_x5_x7_reactivation_produces_new_generation_notification():
    print("\n-- Group X: cancel/re-request/done on the same event_id with a newer updated_at is a NEW notification --")
    tmp_root, db_path = make_temp_env("reserve_x5_")
    ns = build_reserve_ns(db_path)
    try:
        seed_buyer(db_path, user_id=14005, source_key="srcx5")
        eid = seed_reserve_event(db_path, source_key="srcx5", primary_key="pX5", reserve_key="rX5", status="done")

        await ns["_rsvan_sweep_source"]("srcx5", [14005])
        gen1 = ns["_pf_get_setting"](f"rsvan_sent_{eid}_14005")
        check("X5. first done generation is sent", bool(gen1), gen1)

        # Same row/id: cancel (storage.reserve_activation_cancel accepts
        # 'done'), then a later, distinct completion with a NEWER updated_at.
        # An explicit +5s offset from gen1 (not real wall-clock time) avoids
        # a same-second collision with gen1 -- generation strings only have
        # whole-second resolution, so a fast test run could otherwise land
        # the second 'done' transition in the SAME second as the first.
        gen2_ts = _iso(datetime.fromisoformat(gen1) + timedelta(seconds=5))
        set_event_status(db_path, eid, "cancelled", updated_at=gen2_ts)
        set_event_status(db_path, eid, "requested", updated_at=gen2_ts)
        set_event_status(db_path, eid, "creating", updated_at=gen2_ts)
        set_event_status(db_path, eid, "done", updated_at=gen2_ts)

        await ns["_rsvan_sweep_source"]("srcx5", [14005])
        sends = [c for c in ns["__client__"].calls if c[0] == "send_message"]
        check("X6. the second, genuinely new completion of the SAME event_id IS delivered as a new notification", len(sends) == 2, sends)

        gen2 = ns["_pf_get_setting"](f"rsvan_sent_{eid}_14005")
        check("X7. the stored dedup value advanced from generation 1's timestamp to generation 2's timestamp", gen2 != gen1 and bool(gen2), (gen1, gen2))

        # No duplicate on a further sweep of the same (now current) generation.
        await ns["_rsvan_sweep_source"]("srcx5", [14005])
        sends2 = [c for c in ns["__client__"].calls if c[0] == "send_message"]
        check("X6b. a sweep after the second generation does not duplicate it", len(sends2) == 2, sends2)
    finally:
        cleanup_env(tmp_root)


async def test_x8_x9_two_recipients_generation_partial_then_both():
    print("\n-- Group X: two recipients -- one already has generation 1, only the other is notified for gen 1; both get gen 2 --")
    tmp_root, db_path = make_temp_env("reserve_x8_")
    ns = build_reserve_ns(db_path)
    try:
        seed_buyer(db_path, user_id=14008, source_key="srcx8")  # A
        seed_buyer(db_path, user_id=14009, source_key="srcx8")  # B
        eid = seed_reserve_event(db_path, source_key="srcx8", primary_key="pX8", reserve_key="rX8", status="done")

        bts = ns["_rsvan_ensure_baseline"]()
        row = ns["_rsvan_done_events_for_source"]("srcx8", baseline_ts=bts)[0]
        gen1 = ns["_rsvan_canonical_generation"](row["updated_at"])
        ns["_pf_set_setting"](f"rsvan_sent_{eid}_14008", gen1)  # A already has generation 1

        await ns["_rsvan_sweep_source"]("srcx8", [14008, 14009])
        sends1 = [c for c in ns["__client__"].calls if c[0] == "send_message"]
        uids_sent = sorted(c[1] for c in sends1)
        check("X8. generation 1 is sent only to B (A already has that exact generation marker)", uids_sent == [14009], sends1)

        gen2_ts = _iso(datetime.fromisoformat(gen1) + timedelta(seconds=5))
        set_event_status(db_path, eid, "cancelled", updated_at=gen2_ts)
        set_event_status(db_path, eid, "done", updated_at=gen2_ts)  # generation 2, unambiguously newer
        await ns["_rsvan_sweep_source"]("srcx8", [14008, 14009])
        sends2 = [c for c in ns["__client__"].calls if c[0] == "send_message"]
        # Slice by the PRIOR call-list length (not "not in sends1") -- the
        # notification text is identical for both generations of the same
        # primary/reserve pair, so a membership filter would wrongly drop a
        # genuinely new call that happens to be content-identical to an
        # earlier one.
        new_sends = sends2[len(sends1):]
        uids_sent2 = sorted(c[1] for c in new_sends)
        check("X9. generation 2 is delivered to BOTH A and B, exactly once each", uids_sent2 == [14008, 14009], new_sends)
    finally:
        cleanup_env(tmp_root)


