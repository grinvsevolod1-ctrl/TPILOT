class FakeButton:
    def __init__(self, text, data):
        self.text = str(text)
        self.data = data if isinstance(data, (bytes, bytearray)) else str(data).encode("utf-8")

    @classmethod
    def inline(cls, text, data=b""):
        return cls(text, data)


class FakeEventsNS:
    CallbackQuery = object()


class MessageNotModifiedError(Exception):
    pass


class FakeClient:
    """Records every send/delete/edit for assertions. send_fail_uids/
    delete_fail_uids/edit_fail_uids force a raised exception for exactly
    the given user_id (matching the real client's call shape)."""

    def __init__(self):
        self.calls: list = []
        self.send_fail_uids: set = set()
        self.delete_fail_uids: set = set()
        self.edit_fail_uids: set = set()
        self._next_id = 1000

    def on(self, *a, **kw):
        def _decorator(fn):
            return fn
        return _decorator

    async def send_message(self, uid, text, buttons=None):
        self.calls.append(("send_message", int(uid), text, buttons))
        if int(uid) in self.send_fail_uids:
            raise RuntimeError("simulated send failure")
        self._next_id += 1
        return SimpleNamespace(id=self._next_id)

    async def delete_messages(self, uid, mids):
        self.calls.append(("delete_messages", int(uid), list(mids)))
        if int(uid) in self.delete_fail_uids:
            raise RuntimeError("simulated delete failure")

    async def edit_message(self, uid, mid, text, buttons=None):
        self.calls.append(("edit_message", int(uid), int(mid), text, buttons))
        if int(uid) in self.edit_fail_uids:
            raise RuntimeError("simulated edit failure")


