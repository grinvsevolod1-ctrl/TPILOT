class _CallRecorder:
    """Fake for a function that must NEVER be called from the restore path.
    Records every call; also usable as a plain stand-in returning a fixed
    value when a scenario needs the untouched legacy branch to still work."""

    def __init__(self, return_value=None):
        self.calls: list[tuple] = []
        self.return_value = return_value

    def __call__(self, *a, **k):
        self.calls.append((a, k))
        return self.return_value


class _ButtonsFake:
    """State-aware: reads the REAL temp DB so tests can distinguish "buttons
    computed before the repair committed" from "after". Non-None iff
    access_users.is_enabled=1 for this uid."""

    def __init__(self, db_path):
        self.db_path = db_path
        self.calls: list[int] = []

    def __call__(self, uid):
        self.calls.append(int(uid))
        con = sqlite3.connect(self.db_path)
        try:
            row = con.execute(
                "SELECT is_enabled FROM access_users WHERE tg_user_id=?", (int(uid),)
            ).fetchone()
            enabled = bool(row and int(row[0] or 0) == 1)
        finally:
            con.close()
        return [["BTN"]] if enabled else None


