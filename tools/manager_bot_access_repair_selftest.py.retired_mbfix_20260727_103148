    check("A7: access_targets still exactly one row (no duplicate insert)",
          len(_rows(db, "access_targets", tg_user_id=600)) == 1)

    # A8 (R6/R7 lineage): no active manager at all, and ambiguous identity.
    db = _make_temp_db()
    result_a8 = _helper_ns(db)["_mbaccess_restore_access"](603)
    check("A8: no active manager at all -> not_applicable, zero writes", result_a8 == "not_applicable" and not _rows(db, "access_targets", tg_user_id=603))

    db = _make_temp_db()
    _seed_manager(db, "dup1", 604)
    _seed_manager(db, "dup2", 604)
    _seed_access_user(db, 604)
