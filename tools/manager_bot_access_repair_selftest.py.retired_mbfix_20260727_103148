    anchor9b = "            if str(user_row['scope_mode'] or 'selected').strip().lower() == 'all':\n                con.rollback()\n                return 'not_applicable'\n"
    check("A9 mutation precondition: transactional scope_mode='all' recheck anchor found", anchor9b in mutated_a9)
