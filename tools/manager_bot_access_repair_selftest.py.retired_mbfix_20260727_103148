# Section E -- error path (item 12) and username irrelevance (item 18)
# ==========================================================================

def run_error_and_username_checks() -> None:
    print("\n-- Section E: DB failure -> 'error', username plays no role --")

    # E1: force a genuine SQLite failure at the INSERT step (drop the target
    # table after the pre-checks already passed) -- must return 'error' and,
    # through the full /start flow, must NOT fall through to either fallback.
    db = _make_temp_db()
    _seed_manager(db, "errmgr", 950)
    _seed_access_user(db, 950)
    _seed_mba(db, 950, "errmgr")
    _exec(db, "DROP TABLE access_targets")
    result_e1 = _helper_ns(db)["_mbaccess_restore_access"](950)
    check("E1: bare helper returns 'error' when the write fails", result_e1 == "error", detail=result_e1)

    db2 = _make_temp_db()
    _seed_manager(db2, "errmgr2", 951)
    _seed_access_user(db2, 951)
    _seed_mba(db2, 951, "errmgr2")
    _exec(db2, "DROP TABLE access_targets")
    ns = build_start_ns(db2)
    event = _FakeEvent(951, _FakeSender(username="err_tg"))
    run_start(ns, event)
    check("E1: full /start flow shows the retry-later message on error",
          event.responses and "Повторите /start" in event.responses[0][0],
          detail=str(event.responses))
    check("E1: error path never falls through to reconcile or auto_grant",
          not ns["_reconcile_fake"].calls and not ns["_auto_grant_fake"].calls)

    # E1b (round-5 review, MEDIUM R3): _connect() itself raising (not just a
    # later con.execute()) must ALSO produce 'error', not an uncaught
    # exception. Before the R3 fix, con = _connect() sat OUTSIDE the try
    # block, so this exact scenario escaped uncaught -- proven empirically in
    # round-5 review. All pre-checks pass (so the code reaches the point
    # where it opens the write connection), then the Nth _connect() call
    # (the one used for the write transaction) raises.
    db1b = _make_temp_db()
    _seed_manager(db1b, "errmgr3", 960)
    _seed_access_user(db1b, 960)
    _seed_mba(db1b, 960, "errmgr3")
    ns1b = _helper_ns(db1b)
    real_connect_1b = ns1b["_connect"]
    calls_1b = {"n": 0}

    def _flaky_connect():
        calls_1b["n"] += 1
        if calls_1b["n"] >= 5:
            raise sqlite3.OperationalError("injected: unable to open database file")
        return real_connect_1b()

    ns1b["_connect"] = _flaky_connect
    try:
        result_e1b = ns1b["_mbaccess_restore_access"](960)
        e1b_exc = None
    except Exception as exc:
        result_e1b = None
        e1b_exc = exc
    check("E1b: a raising _connect() (not just a later execute failure) still returns 'error', "
          "no uncaught exception escapes the helper",
          result_e1b == "error" and e1b_exc is None,
          detail=f"result={result_e1b!r} exception={e1b_exc!r} calls={calls_1b['n']}")

    # E2 (item 18; round-6 review fix): identical DB state, two different
    # usernames (one empty, one colliding with an unrelated manager's own
    # username) -> identical outcome, proving username plays zero role in
    # the new contract. The prior version only compared outcomes[0] to
    # outcomes[1] -- vacuous, since it also passes when /start is completely
    # broken (both iterations then produce the SAME generic error response,
    # proven empirically: injecting an unconditional exception right after
    # identity resolution makes both runs return
    # [('Ошибка ManagerBot /start.', False)], which still satisfies
    # outcomes[0] == outcomes[1]). Fixed by pinning both outcomes to the
    # actual healthy restoration, not merely to each other.
    EXPECTED_E2_OUTCOME = ("✅ Доступ восстановлен", True)

    def _seed_e2_scenario(db_path):
        _seed_manager(db_path, "unmgr", 952)
        _seed_manager(db_path, "othermgr", 953, telegram_username="collides_with_another_manager")
        _seed_access_user(db_path, 952)
        _seed_mba(db_path, 952, "unmgr")

    def _run_e2(mutate=None):
        result = []
        for uname in ("", "collides_with_another_manager"):
            db3 = _make_temp_db()
            _seed_e2_scenario(db3)
            ns3 = build_start_ns(db3, mutate=mutate)
            event3 = _FakeEvent(952, _FakeSender(username=uname))
            run_start(ns3, event3)
            result.append((event3.responses[0][0] if event3.responses else None,
                           bool(_rows(db3, "access_targets", tg_user_id=952, manager_key="unmgr"))))
        return result

    outcomes = _run_e2()
    check("E2: both usernames produce the same outcome",
          outcomes[0] == outcomes[1], detail=str(outcomes))
    check("E2: that shared outcome is the actual healthy restoration (✅ + a real access_targets "
          "row), not two BROKEN runs merely agreeing with each other",
          outcomes[0] == EXPECTED_E2_OUTCOME and outcomes[1] == EXPECTED_E2_OUTCOME,
          detail=str(outcomes))

    # E2 mutation-proof: remove the restore call entirely (same anchor/style
    # as X1) so both usernames now fall through to the legacy delegate
    # instead of being repaired. Proves the corrected assertion above
    # actually discriminates: two BROKEN-but-matching outcomes must fail it.
    def _e2_mutate(src):
        anchor = "restore_result = _mbaccess_restore_access(uid)"
        check("E2 mutation precondition: anchor found", anchor in src)
        return src.replace(anchor, "restore_result = 'not_applicable'  # E2 mutation: restore call removed", 1)

    mutant_outcomes = _run_e2(mutate=_e2_mutate)
    check("E2 mutation-proof: with the restore call removed, both usernames still agree with "
          "each other (LEGACY/no-repair) but that shared outcome is no longer the healthy "
          "restoration -- the corrected assertion fails for the intended reason",
          mutant_outcomes[0] == mutant_outcomes[1] and mutant_outcomes[0] != EXPECTED_E2_OUTCOME,
          detail=str(mutant_outcomes))


# ==========================================================================
# Section F -- BLOCKER B1 regression: prove the fix structurally prevents the
# historical-backlog burst, using the REAL AST-extracted M2.6B/M2.6E SQL.
# ==========================================================================

def run_blocker_b1_regression() -> None:
    print("\n-- Section F: BLOCKER B1 regression (real backfill SQL, no mock) --")

    def _deliverable_count(dbp, uid, key):
        """Round-5 review (R6): this used to be a hand-copied predicate that
        had already drifted from production (missing the next_attempt_at
        backoff branch and the LIMIT 30 cap). Now calls the REAL, active
        _fetch_unsent_events_for_user (AST-extracted, same function the
        running ManagerBot uses) so this can never silently drift again."""
        return len(_helper_ns(dbp)["_fetch_unsent_events_for_user"](uid, [key]))

    # F1: baseline (real, unmutated code) -- brand-new uid, no access_users,
    # 50 historical events already on the books. After /start (helper reports
    # not_applicable; auto_grant is faked as a no-op so it does not itself
    # write anything -- its own correctness is protected/unchanged/out of
    # scope), running the REAL extracted backfill against this DB must
    # create ZERO manager_bot_access rows, because there is no access_users
    # row for the JOIN to match at all.
    db = _make_temp_db()
    _seed_manager(db, "newmgr", 9001, display_name="New Guy")
    for _ in range(50):
        _seed_event(db, "newmgr")
    ns = build_start_ns(db, auto_grant_return=True)
    event = _FakeEvent(9001, _FakeSender(username="newmgr_tg"))
    run_start(ns, event)
    check("F1: helper created no access_users row for the brand-new uid", not _rows(db, "access_users", tg_user_id=9001))
    check("F1: helper created no access_targets row for the brand-new uid", not _rows(db, "access_targets", tg_user_id=9001))
    check("F1: the legacy auto-grant path was reached instead (unchanged baseline)", bool(ns["_auto_grant_fake"].calls))
    con = sqlite3.connect(db)
    con.executescript("")  # no-op, keeps con usage symmetrical with below
    con.execute(M2_6B_BACKFILL_SQL)
    con.execute(M2_6E_CUTOFF_REPAIR_SQL)
    con.commit()
    con.close()
    check("F1: the REAL backfill+cutoff-repair SQL created ZERO manager_bot_access rows (no access_users/access_targets pair to join)",
          not _rows(db, "manager_bot_access", tg_user_id=9001))
    check("F1: zero historical events deliverable after the backfill", _deliverable_count(db, 9001, "newmgr") == 0)

    # F2: baseline for the ACTUAL repaired scenario (A1-style) -- the
    # surviving manager_bot_access row's own cutoff must still gate delivery
    # correctly after the restore, and the backfill (a no-op here, since
    # INSERT OR IGNORE never touches an existing row) must not change it.
    db = _make_temp_db()
    _seed_manager(db, "r2mgr", 9002)
    _seed_access_user(db, 9002)
    _seed_mba(db, 9002, "r2mgr", cutoff=5)
    for i in range(1, 11):
        _seed_event(db, "r2mgr")
    before_deliv = _deliverable_count(db, 9002, "r2mgr")
    check("F2 precondition: 5 events (6-10) are deliverable before any restore", before_deliv == 5, detail=before_deliv)
    ns = build_start_ns(db)
    event = _FakeEvent(9002, _FakeSender(username="r2_tg"))
    run_start(ns, event)
    con = sqlite3.connect(db)
    con.execute(M2_6B_BACKFILL_SQL)
    con.execute(M2_6E_CUTOFF_REPAIR_SQL)
    con.commit()
    con.close()
    check("F2: deliverable count unchanged after restore + backfill (still exactly 5, not all 10)",
          _deliverable_count(db, 9002, "r2mgr") == before_deliv, detail=_deliverable_count(db, 9002, "r2mgr"))
    mba_f2 = _row(db, "manager_bot_access", tg_user_id=9002, manager_key="r2mgr")
    check("F2: event_cutoff_id is still exactly 5 (never read, never written by the helper)",
          int(mba_f2.get("event_cutoff_id") or 0) == 5, detail=str(mba_f2))

    # F3 (X9 mutation-proof / H4): remove the "matching manager_bot_access
    # row must already exist" guard (BOTH the outer pre-check and the
    # transactional re-check) -- proving this is the exact guard that
    # structurally prevents the burst. With it removed, a uid that already
    # has access_users (e.g. an existing operator picking up a brand-new,
    # never-granted manager_key) now gets access_targets repaired with NO
    # matching manager_bot_access row -- recreating precisely the precondition
    # the real backfill exploits.
    real_helper_src = src_of(MB_TREE, "_mbaccess_restore_access")
    anchor_outer = "    if not mba_row:\n        return 'not_applicable'\n"
    check("F3 precondition: outer mba_row-exists anchor found", anchor_outer in real_helper_src)
    mutated9 = real_helper_src.replace(anchor_outer, "", 1)
    # The transactional recheck must be neutralized, not blanked out: fetchone()
    # returns None (not {}) for a missing row, and the very next line indexes
    # mba_recheck['revoked'] -- blank-removing this guard would crash on that
    # None dereference (a different, uninteresting failure mode) instead of
    # actually exercising the "guard removed" behavior this mutation targets.
    anchor_txn = "            if not mba_recheck:\n                con.rollback()\n                return 'not_applicable'\n"
    check("F3 precondition: transactional mba_recheck anchor found", anchor_txn in mutated9)
    mutated9 = mutated9.replace(
        anchor_txn,
        "            if mba_recheck is None:\n                mba_recheck = {'revoked': 0}\n",
        1,
    )
    check("F3 precondition: mutation actually changed the text", mutated9 != real_helper_src)

    db9 = _make_temp_db()
    _seed_manager(db9, "newkeymgr", 9003)
    _seed_access_user(db9, 9003)
    for _ in range(50):
        _seed_event(db9, "newkeymgr")
    ns9 = _exec_mutated_helper(mutated9, db_path=db9)
    result9 = ns9["_mbaccess_restore_access"](9003)
    check("F3 mutation-proof: without the manager_bot_access-exists guard, a brand-new key now gets "
          "access_targets repaired with no matching manager_bot_access row",
          result9 == "restored" and bool(_rows(db9, "access_targets", tg_user_id=9003, manager_key="newkeymgr")),
          detail=result9)
    con9 = sqlite3.connect(db9)
    con9.execute(M2_6B_BACKFILL_SQL)
    con9.execute(M2_6E_CUTOFF_REPAIR_SQL)
    con9.commit()
    con9.close()
    mba9 = _row(db9, "manager_bot_access", tg_user_id=9003, manager_key="newkeymgr")
    check("F3 mutation-proof: the subsequent restart's REAL backfill now DOES create a manager_bot_access "
          "row with event_cutoff_id=0 -- reproducing the exact BLOCKER B1 burst -- proving the guard removed "
          "here is precisely what keeps this from happening in production",
          bool(mba9) and int(mba9.get("event_cutoff_id") or 0) == 0, detail=str(mba9))
    # The REAL delivery query caps at LIMIT 30 (round-5 review, R6 -- the
    # prior hand-copied predicate omitted this and wrongly expected all 50).
    # 30 is still the entire first page of the burst, not a small residual --
    # the point (all currently-fetchable historical events becoming
    # deliverable at once) stands.
    check("F3 mutation-proof: the burst is confirmed via the REAL delivery query (capped at its own LIMIT 30, "
          "not the naive full 50 a simplified predicate would report)",
          _deliverable_count(db9, 9003, "newkeymgr") == 30, detail=_deliverable_count(db9, 9003, "newkeymgr"))


