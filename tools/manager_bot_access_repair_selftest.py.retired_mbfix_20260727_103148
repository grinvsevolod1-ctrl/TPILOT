def _base_ns(db_path):
    return {
        "sqlite3": sqlite3, "Path": Path, "datetime": datetime, "timedelta": timedelta,
        "Any": object, "Dict": dict, "List": list,
        "TPILOT_DB_PATH": db_path,
        "log": _NullLogger(),
    }


def build_start_ns(db_path, mutate=None, auto_grant_return=False):
    picked = {}
    for node in MB_TREE.body:
        nm = getattr(node, "name", None)
        if nm in MB_TARGET_NAMES:
            picked[nm] = node
    missing = MB_TARGET_NAMES - set(picked)
    if missing:
        raise AssertionError(f"missing defs in manager_bot.py: {missing}")
    module_src = "\n\n".join(ast.unparse(picked[n]) for n in sorted(picked))
    if mutate is not None:
        module_src = mutate(module_src)

    reconcile_fake = _CallRecorder()
    auto_grant_fake = _CallRecorder(return_value=auto_grant_return)
    legacy_fake = _CallRecorder()

    async def _legacy_handler(event, uid):
        legacy_fake((event, uid), {})
        await event.respond("LEGACY", buttons=None)

    buttons_fake = _ButtonsFake(db_path)
    ns = _base_ns(db_path)
    ns.update({
        "_reconcile_reconnected_manager": reconcile_fake,
        "_auto_grant_manager_bot_access": auto_grant_fake,
        "_mbstat_start_buttons": buttons_fake,
        "_M26D_ORIG_HANDLE_START": _legacy_handler,
    })
    exec(compile(module_src, "<manager_bot.py:start>", "exec"), ns)
    ns["_reconcile_fake"] = reconcile_fake
    ns["_auto_grant_fake"] = auto_grant_fake
    ns["_legacy_fake"] = legacy_fake
    ns["_buttons_fake"] = buttons_fake
    return ns


def run_start(ns, event):
    ns["_reconcile_fake"].calls.clear()
    ns["_auto_grant_fake"].calls.clear()
    ns["_legacy_fake"].calls.clear()
    ns["_buttons_fake"].calls.clear()
    asyncio.run(ns["_handle_start"](event))


def _helper_ns(db_path, helper_src_override=None):
    """Namespace containing only the bare _mbaccess_restore_access plus its
    real, unmutated dependencies -- for tests that call the helper directly
    rather than through the full /start flow (race injection, direct
    return-value assertions)."""
    picked = {}
    for node in MB_TREE.body:
        nm = getattr(node, "name", None)
        if nm in (MB_TARGET_NAMES - {"_handle_start", "_mbaccess_restore_access"}):
            picked[nm] = node
    helper_src = helper_src_override if helper_src_override is not None else src_of(MB_TREE, "_mbaccess_restore_access")
    module_src = "\n\n".join(ast.unparse(picked[n]) for n in sorted(picked)) + "\n\n" + helper_src
    ns = _base_ns(db_path)
    exec(compile(module_src, "<manager_bot.py:helper>", "exec"), ns)
    return ns


def _exec_mutated_helper(mutated_helper_src: str, db_path: str) -> dict:
    return _helper_ns(db_path, helper_src_override=mutated_helper_src)


def _make_race_connect(db_path, trigger_call_index, race_sql, race_params=()):
    """A drop-in replacement for the extracted _connect() that performs a
    one-shot DB mutation (via its own short-lived connection) exactly when
    the Nth call to _connect() is serviced, then returns a normal connection.
    Used to simulate an admin action landing in the exact TOCTOU window
    between _mbaccess_restore_access's optimistic pre-reads and its own
    transactional re-verification -- the precise race window its own
    docstring documents. The caller must assert state["triggered"] to prove
    the assumed call-count actually lined up (never a silent no-op)."""
    state = {"count": 0, "triggered": False}

    def _race_connect():
        state["count"] += 1
        if state["count"] == trigger_call_index and not state["triggered"]:
            state["triggered"] = True
            raw = sqlite3.connect(db_path)
            try:
                raw.execute(race_sql, race_params)
                raw.commit()
            finally:
                raw.close()
        con = sqlite3.connect(db_path, timeout=30)
        con.row_factory = sqlite3.Row
        try:
            con.execute("PRAGMA journal_mode=WAL;")
            con.execute("PRAGMA busy_timeout=30000;")
        except Exception:
            pass
        return con

    return _race_connect, state


