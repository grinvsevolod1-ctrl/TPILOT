_TEMP_DB_PATHS: list = []


def _make_temp_db() -> str:
    fd, path = tempfile.mkstemp(prefix="mba_repair_", suffix=".db")
    os.close(fd)
    os.remove(path)
    _guard_temp_db(path)
    _TEMP_DB_PATHS.append(path)
    con = sqlite3.connect(path)
    try:
        con.execute(
            """
            CREATE TABLE managers (
                manager_key TEXT PRIMARY KEY,
                display_name TEXT DEFAULT '',
                tg_user_id INTEGER,
                telegram_username TEXT DEFAULT '',
                status TEXT DEFAULT '',
                is_enabled INTEGER DEFAULT 1,
                manual_stopped INTEGER DEFAULT 0
            )
            """
        )
        con.execute(
            """
            CREATE TABLE access_users(
                tg_user_id INTEGER PRIMARY KEY,
                display_name TEXT DEFAULT '',
                username TEXT DEFAULT '',
                access_level INTEGER NOT NULL DEFAULT 1,
                scope_mode TEXT NOT NULL DEFAULT 'selected',
                is_enabled INTEGER NOT NULL DEFAULT 1,
                created_by INTEGER,
                created_at TEXT NOT NULL DEFAULT '',
                updated_at TEXT NOT NULL DEFAULT ''
            )
            """
        )
        con.execute(
            """
            CREATE TABLE access_targets(
                tg_user_id INTEGER NOT NULL,
                manager_key TEXT NOT NULL,
                created_at TEXT NOT NULL DEFAULT '',
                PRIMARY KEY(tg_user_id, manager_key)
            )
            """
        )
        con.execute(
            """
            CREATE TABLE manager_bot_access (
                tg_user_id INTEGER NOT NULL,
                manager_key TEXT NOT NULL DEFAULT '',
                can_receive_cards INTEGER NOT NULL DEFAULT 0,
                can_set_status INTEGER NOT NULL DEFAULT 0,
                can_view_stats INTEGER NOT NULL DEFAULT 0,
                stats_format TEXT NOT NULL DEFAULT 'light',
                allow_custom_period INTEGER NOT NULL DEFAULT 0,
                auto_granted INTEGER NOT NULL DEFAULT 0,
                granted_by INTEGER DEFAULT 0,
                granted_at TEXT NOT NULL DEFAULT '',
                revoked INTEGER NOT NULL DEFAULT 0,
                revoked_by INTEGER DEFAULT 0,
                revoked_at TEXT NOT NULL DEFAULT '',
                event_cutoff_id INTEGER NOT NULL DEFAULT 0,
                created_at TEXT NOT NULL DEFAULT '',
                updated_at TEXT NOT NULL DEFAULT '',
                PRIMARY KEY (tg_user_id, manager_key)
            )
            """
        )
        # The three forbidden tables -- present so the byte-identical
        # before/after snapshots have something real to compare, and so a
        # regression that DID touch them would actually be caught. Schema is
        # the REAL production DDL (AST-extracted from init_schema, including
        # the real manager_bot_sent ADD-COLUMN migrations), not a hand copy
        # -- round-5 review (R5) found a hand-typed stub here diverged from
        # production enough to make the B1 regression's use of the real
        # delivery query crash outright.
        con.executescript(EVENTS_SENT_CARDS_SCRIPT)
        for _col, _decl in MANAGER_BOT_SENT_ALTER_COLUMNS:
            con.execute(f"ALTER TABLE manager_bot_sent ADD COLUMN {_col} {_decl}")
        con.execute("CREATE TABLE manager_access_requests(user_id INTEGER PRIMARY KEY, username TEXT DEFAULT '', first_name TEXT DEFAULT '', last_name TEXT DEFAULT '', matched_manager_key TEXT DEFAULT '', match_kind TEXT DEFAULT '', status TEXT DEFAULT 'new', requested_at TEXT DEFAULT '', updated_at TEXT DEFAULT '')")
        con.commit()
    finally:
        con.close()
    return path


