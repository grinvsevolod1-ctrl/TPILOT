def run_forbidden_area_checks() -> None:
    print("\n-- Section B: forbidden-area guards (card/event/cutoff must be untouched) --")

    # B1 (item 8): full snapshot of the three forbidden tables, before/after
    # the A1 bug-state scenario, with pre-existing rows so a regression that
    # touched them would actually be caught.
    db = _make_temp_db()
    _seed_manager(db, "snapmgr", 700, display_name="Snap")
    _seed_access_user(db, 700)
    _seed_mba(db, 700, "snapmgr")
    _seed_event(db, "snapmgr")
    _seed_event(db, "snapmgr")
    _exec(db, "INSERT INTO manager_lead_cards(tg_user_id, bot_chat_id, message_id, chat_id, manager_key, updated_at)"
              " VALUES (700, 700, 1, 700, 'snapmgr', '2026-01-01')")
    before = {t: _full_snapshot(db, t) for t in FORBIDDEN_TABLES}
    ns = build_start_ns(db)
    event = _FakeEvent(700, _FakeSender(username="snap_tg"))
    run_start(ns, event)
    check("B1 precondition: restore actually ran", event.responses and "✅" in event.responses[0][0])
    after = {t: _full_snapshot(db, t) for t in FORBIDDEN_TABLES}
    for t in FORBIDDEN_TABLES:
        check(f"B1: {t} is byte-identical before/after the restore", before[t] == after[t],
              detail=f"before={before[t]} after={after[t]}")

    # B2: source-scan -- the new helper and the inserted /start fragment
    # contain NONE of the forbidden names.
    helper_src = src_of(MB_TREE, "_mbaccess_restore_access")
    for name in FORBIDDEN_NAMES:
        check(f"B2: _mbaccess_restore_access source does not reference {name!r}", name not in helper_src,
              detail=helper_src[:200])

    marker_start = "TPILOT MANAGER BOT ACCESS-ONLY RESTORE 20260727 START"
    marker_end = "TPILOT MANAGER BOT ACCESS-ONLY RESTORE 20260727 END"
    idx_a = MB_SRC.find(marker_start, MB_SRC.find("async def _handle_start(event, tg_user_id: int | None"))
    idx_b = MB_SRC.find(marker_end, idx_a)
    check("B2 precondition: new /start fragment markers found", idx_a != -1 and idx_b > idx_a)
    new_fragment = MB_SRC[idx_a:idx_b]
    for name in FORBIDDEN_NAMES:
        check(f"B2: the new /start fragment does not reference {name!r}", name not in new_fragment)

    # B3: the helper's own signature takes only uid (item 18 -- no identity/
    # username parameter at all, so username cannot possibly affect it).
    helper_def = last_def(MB_TREE, "_mbaccess_restore_access")
    arg_names = [a.arg for a in helper_def.args.args]
    check("B3 (item 18): _mbaccess_restore_access takes exactly one parameter, uid", arg_names == ["uid"], detail=str(arg_names))
    # Excludes the docstring (which legitimately says "ambiguous identity" in
    # prose) -- this checks the executable BODY never reads a username/identity.
    helper_body_stmts = helper_def.body[1:] if (
        helper_def.body and isinstance(helper_def.body[0], ast.Expr)
        and isinstance(getattr(helper_def.body[0], "value", None), ast.Constant)
        and isinstance(helper_def.body[0].value.value, str)
    ) else helper_def.body
    helper_body_src = "\n".join(ast.unparse(s) for s in helper_body_stmts)
    check("B3: helper's executable body never references 'username' or 'identity'",
          "username" not in helper_body_src and "identity" not in helper_body_src,
          detail=helper_body_src[:200])


