# pre-check) is what closes each TOCTOU window (items 13, 14, 15)
# ==========================================================================

def run_race_checks() -> None:
    print("\n-- Section C: TOCTOU races between the pre-reads and the transaction --")

    # C1 (item 13): manager deleted between lookup and INSERT -> no orphan target.
    db = _make_temp_db()
    _seed_manager(db, "racemgr1", 900)
    _seed_access_user(db, 900)
    _seed_mba(db, 900, "racemgr1")
    ns = _helper_ns(db)
    race_connect, state = _make_race_connect(
        db, trigger_call_index=5,
        race_sql="DELETE FROM managers WHERE tg_user_id=? AND manager_key=?", race_params=(900, "racemgr1"),
    )
    ns["_connect"] = race_connect
    result = ns["_mbaccess_restore_access"](900)
    check("C1 precondition: the race fired at the expected call", state["triggered"])
    check("C1: manager deleted mid-flight -> not_applicable, no orphan access_targets row",
          result == "not_applicable" and not _rows(db, "access_targets", tg_user_id=900), detail=result)

    # C2 (item 14): admin disables access_users between lookup and INSERT.
    db = _make_temp_db()
    _seed_manager(db, "racemgr2", 901)
    _seed_access_user(db, 901)
    _seed_mba(db, 901, "racemgr2")
    ns = _helper_ns(db)
    race_connect, state = _make_race_connect(
        db, trigger_call_index=5,
        race_sql="UPDATE access_users SET is_enabled=0 WHERE tg_user_id=?", race_params=(901,),
    )
    ns["_connect"] = race_connect
    result = ns["_mbaccess_restore_access"](901)
    check("C2 precondition: the race fired at the expected call", state["triggered"])
    check("C2: access_users disabled mid-flight -> disabled, no access_targets row written",
          result == "disabled" and not _rows(db, "access_targets", tg_user_id=901), detail=result)

    # C3 (item 15): revoked flips to 1 between lookup and INSERT.
    db = _make_temp_db()
    _seed_manager(db, "racemgr3", 902)
    _seed_access_user(db, 902)
    _seed_mba(db, 902, "racemgr3")
    ns = _helper_ns(db)
    race_connect, state = _make_race_connect(
        db, trigger_call_index=5,
        race_sql="UPDATE manager_bot_access SET revoked=1 WHERE tg_user_id=? AND manager_key=?", race_params=(902, "racemgr3"),
    )
    ns["_connect"] = race_connect
    result = ns["_mbaccess_restore_access"](902)
    check("C3 precondition: the race fired at the expected call", state["triggered"])
    check("C3: revoked flips to 1 mid-flight -> revoked, no access_targets row written",
          result == "revoked" and not _rows(db, "access_targets", tg_user_id=902), detail=result)

    # C4 (item 16): two concurrent /start-equivalent calls for the SAME
    # (uid, manager_key) -> exactly one consistent access_targets row, no
    # exception/'error' from either thread.
    db = _make_temp_db()
    _seed_manager(db, "concmgr", 903)
    _seed_access_user(db, 903)
    _seed_mba(db, 903, "concmgr")
    ns_a = _helper_ns(db)
    ns_b = _helper_ns(db)
    results16 = [None, None]

    def _call16(idx, ns_local):
        results16[idx] = ns_local["_mbaccess_restore_access"](903)

    t1 = threading.Thread(target=_call16, args=(0, ns_a))
    t2 = threading.Thread(target=_call16, args=(1, ns_b))
    t1.start(); t2.start()
    t1.join(timeout=30); t2.join(timeout=30)
    check("C4: neither concurrent call returned 'error'", "error" not in results16, detail=str(results16))
    check("C4: exactly one of the two concurrent calls reports 'restored', the other 'not_applicable'",
          sorted(results16) == ["not_applicable", "restored"], detail=str(results16))
    check("C4: exactly one consistent access_targets row exists afterwards",
          len(_rows(db, "access_targets", tg_user_id=903, manager_key="concmgr")) == 1, detail=str(results16))


